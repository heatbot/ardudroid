// Shared verbatim with "6-Tap Strategy": edit it here, then run pine/build_strategy.py.
const string ENGINE_VERSION = "2.9"

const int BRACKET = 8    // bars a tap bracket extends to the right
const int ZONE_TR = 88   // zone fill transparency
const int FADE_ZT = 95   // faded zone fill transparency
const int FADE_TR = 60   // faded labels / lines transparency
const int MID_TR  = 30   // 50% line transparency
const int LIQ_TR  = 30   // liquidity line transparency
const color FVG_COL = #787B86
const int SHADOW_CAP = 5 // hidden sequences kept: SHADOW_CAP × maxActive
const int MAX_BACK   = 9000  // drawings can't be placed ~10,000+ bars back with xloc.bar_index
const int TRK_CAP    = 800   // entry trackers kept (pending or with exit variants still open)
const int NV         = 12    // exit variants A–L
const int NM         = 3     // entry modes: 0 50% limit, 1 tap 4 sweep limit, 2 confirmation

// Shadow filter indices; "rr" (index NF) is the R:R optional flag, reported like a filter.
const int F_RUN    = 0
const int F_EXP    = 1
const int F_SUP    = 2
const int F_MINZ   = 3
const int F_MAXZ   = 4
const int F_EXTMIN = 5
const int F_SESS   = 6
const int F_FVG    = 7
const int NF       = 8
var array<string> FNAMES = array.from("runaway", "expiry", "superseded", "minZoneATR", "maxZoneATR", "minTap5Ext", "session", "requireFVG", "rr")
var array<string> FVGTAGS = array.from("nofvg", "fvg", "fvg_touched", "fvg_mitigated")
var array<string> MNAMES = array.from("50% limit", "Tap 4 sweep", "Confirmation")

// Entry mode that drives the chart, alerts and the strategy's orders.
int CHART_MODE = entryMode == "50% limit" ? 0 : entryMode == "Tap 4 sweep" ? 1 : 2

string lblSize = labelSize == "tiny" ? size.tiny : labelSize == "normal" ? size.normal : labelSize == "large" ? size.large : size.small

f_pos(string p) => p == "top_left" ? position.top_left : p == "top_right" ? position.top_right : p == "bottom_left" ? position.bottom_left : position.bottom_right

// ───────────────────────── Types ─────────────────────────
// Trailing stop state for one open trade (see f_trailStep).
type Trail
    array<float> piv        // post-entry pivots on the stop side (micro highs for a short), oldest first
    float  bos              // last post-entry pivot in the trade direction; breaking it trails the stop
    float  sOne             // stop trailed one swing behind
    float  sLatest          // stop trailed to the latest swing

type Seq
    int    id
    int    dir              // 1 = bull, -1 = bear
    int    state = 0        // 0 await3, 1 await4, 2 await5, 3 tap5 trailing, 4 armed, 5 in trade, 6 done
    int    b1
    int    b2
    int    b3
    int    b4
    int    b5
    int    b6               // fill bar (confirmation: the confirmation bar)
    float  p1
    float  p2
    float  p3
    float  p4
    float  p5
    float  mid
    float  entryP
    float  stopP            // current stop (trails in the chart trade)
    float  stop0            // stop at the fill
    float  tgtP
    int    brk3             // bar that broke tap 1
    int    brk5             // bar that broke tap 3
    int    armedBar         // bar where tap 5 locked
    int    spawnBar         // bar the sequence was created
    string result = ""      // "", "target", "stop" or a cancel reason
    bool   faded = false
    float  mfe = 0.0        // max favorable excursion after the fill, in price
    bool   hidden = false   // shadow-kept: runs for stats, never drawn or alerted
    array<bool> tags        // shadow tags by filter index (F_*): would have been cancelled by it
    int    tagBar           // bar of the first shadow tag
    float  zoneATR          // zone height in ATR at spawn
    int    sess             // fill session: 0 NY, 1 London, 2 Asia
    float  rr               // planned R:R (limit modes: at arming; confirmation: at the confirmation)
    bool   optRR = false    // planned R:R outside minRR..maxRR
    bool   opt = false      // optional: R:R flag or daily limit reached
    string optTag = ""      // "rr" or "limit"
    float  mae = 0.0        // max adverse excursion after the fill, in price
    bool   ex2 = false      // skipped under the 2-losses-a-day test
    bool   ex3 = false      // skipped under the 3-losses-a-day test
    float  risk0            // |entry - stop| at the fill
    int    tSpawn           // times (ms) of spawn and arming
    int    tArm
    int    sweepBar         // confirmation (chart mode): sweep start, sweep peak (tap 6) and confirmation level
    float  peak
    float  cl
    Trail  tr               // chart trade trailing stop
    int    stopX            // bar where the drawn stop line starts (moves with the trail)
    bool   sOrdered = false // strategy: an order was placed for this sequence
    bool   sFilled = false  // strategy: the broker emulator filled it
    int    sFillBar
    float  sMfe = 0.0       // strategy: MFE in R since the emulator fill
    bool   sDone = false    // strategy: order cancelled or position closed
    Trail  strl             // strategy: trailing stop for exit variants J/K/L
    label  l1
    label  l2
    label  l3
    label  l4
    label  l5
    label  l6
    label  lDot
    label  lDbg
    line   h1
    line   h2
    line   h3
    line   h4
    line   h5
    line   v3
    line   v5
    box    zone
    line   midLn
    line   eLn
    line   sLn
    line   tLn
    label  eLb
    label  sLb
    label  tLb
    line   lq2              // liquidity lines from taps 2, 4, 5 and the confirmation level
    line   lq4
    line   lq5
    line   lqC
    bool   lq2On = false
    bool   lq4On = false
    bool   lq5On = false
    array<line> oldStops    // faded segments left where the trailed stop used to be
    float  fvgTop           // FVG inside the zone, left by the leg that broke tap 1 (na = none)
    float  fvgBot
    int    fvgBar
    bool   fvgMit = false   // chart view: closed through before the sweep / fill
    string fvgTag = "nofvg" // chart trade's tag: nofvg, fvg, fvg_touched, fvg_mitigated
    box    fvgBox

// One armed sequence under one entry mode. All three modes run in parallel for the
// entry-variants table and the log; the one matching entryMode drives the chart.
type Trk
    Seq    s
    int    mode             // 0 50% limit, 1 tap 4 sweep limit, 2 confirmation
    bool   chart = false
    int    st = 0           // 0 waiting (limit pending / no sweep yet), 1 sweeping, 2 in trade, 3 ended unfilled
    string why = ""         // reason it ended unfilled
    float  p5               // tap 5 (target basis); re-trails while waiting
    float  stopL            // limit modes: stop fixed at arming
    int    sweepBar
    float  peak
    int    peakBar
    float  cl
    float  clPrev           // confirmation level at the previous close (where a stop order would rest)
    array<float> fp         // fractals confirmed since the sweep started: price and bar
    array<int>   fb
    float  entryP
    float  stopP
    float  tgtP
    float  risk0
    float  rr
    int    bFill
    int    tFill
    int    tExit            // exit time under variant A
    int    sess
    bool   vis = true       // in the chart (Enforce) view at the fill
    float  mfe = 0.0
    float  mae = 0.0
    Trail  tr
    array<float> xs         // exit variants A–L: stop, target, result R (na = open), size left, banked R
    array<float> xt
    array<float> xr
    array<float> xrem
    array<float> xbank
    int    xopen = 0
    bool   fvgT = false     // the FVG was touched (limit modes: before the fill; confirmation: by the sweep)
    bool   fvgMit = false   // the FVG was closed through first
    string fvgTag = "nofvg"

// ───────────────────────── Structure & bias ─────────────────────────
// Bias from external structure: close above last swing high -> bull, below last swing low -> bear.
f_bias(int len) =>
    var float lastH = na
    var float lastL = na
    var int   b     = 0
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    if not na(ph)
        lastH := ph
    if not na(pl)
        lastL := pl
    if not na(lastH) and close > lastH
        b := 1
    else if not na(lastL) and close < lastL
        b := -1
    b

float ePH = ta.pivothigh(high, extLen, extLen)
float ePL = ta.pivotlow(low, extLen, extLen)
float iPH = ta.pivothigh(high, intLen, intLen)
float iPL = ta.pivotlow(low, intLen, intLen)
int   ePB = bar_index - extLen
int   iPB = bar_index - intLen
float atr = ta.atr(14)
// Micro pivots for the trailing stop and fractals for the confirmation level.
float tPH = ta.pivothigh(high, trailLen, trailLen)
float tPL = ta.pivotlow(low, trailLen, trailLen)
int   tPB = bar_index - trailLen
float cPH = ta.pivothigh(high, confLen, confLen)
float cPL = ta.pivotlow(low, confLen, confLen)
int   cPB = bar_index - confLen

// Higher timeframe: the last closed HTF bar's bias ([1] with lookahead_on), so it never repaints.
f_biasPrev(int len) =>
    int b = f_bias(len)
    b[1]

int chartBias = f_bias(biasLen)
int htfBias   = nz(request.security(syminfo.tickerid, biasTF, f_biasPrev(biasLen), lookahead = barmerge.lookahead_on))
int autoBias  = biasTF == "" ? chartBias : htfBias
int bias     = biasMode == "Auto" ? autoBias : biasMode == "Bullish" ? 1 : -1

// ───────────────────────── State ─────────────────────────
var array<Seq> active = array.new<Seq>()   // states 0–4
var array<Seq> trades = array.new<Seq>()   // state 5
var array<Seq> hist   = array.new<Seq>()   // finished or cancelled, faded
var array<Seq> shadow = array.new<Seq>()   // hidden (shadow-kept) states 0–4
var array<Trk> trks   = array.new<Trk>()   // entry trackers, all modes

// One entry per resolved chart trade, visible or shadow: R, shadow tags and buckets.
var array<float> trR    = array.new<float>()
var array<int>   trMask = array.new<int>()   // shadow tags as a bit mask (bit NF = rr flag)
var array<int>   trRRb  = array.new<int>()   // planned R:R: 0 <1.5, 1 1.5–2, 2 2–3, 3 3–5, 4 >5
var array<int>   trSess = array.new<int>()
var array<int>   trExt  = array.new<int>()   // tap 5 extension from mid: 0 <1, 1 1–2, 2 2–3, 3 >3 zone heights
var array<int>   trZh   = array.new<int>()   // zone height in ATR, same buckets
var array<int>   trA2F  = array.new<int>()   // bars arm -> fill: 0 ≤10, 1 11–40, 2 >40
var array<int>   trFvg  = array.new<int>()   // FVG tag index in FVGTAGS

// Chart (visible) trades only.
var array<float> visR    = array.new<float>()   // R per trade
var array<float> stopMFE = array.new<float>()   // stopped trades: MFE in R
var array<float> winMAE  = array.new<float>()   // winners: MAE in R
var array<int>   day     = array.new_int(4, 0)  // [trading day, losses today, losses under 2-limit test, under 3-limit test]

// Entry-variants table: R under exit variant A per entry mode (chart-view trades).
var array<float> mRA0 = array.new<float>()
var array<float> mRA1 = array.new<float>()
var array<float> mRA2 = array.new<float>()

var map<string, int> cnt = map.new<string, int>()   // debug counters
var array<float> acc   = array.new_float(2, 0.0)   // [unused, sum of bars arm -> fill]
var map<string, float> fs = map.new<string, float>()   // trade magnitude stats (R, points, $)
var array<bool>  dirty = array.from(false)          // labels changed -> redo stacking

// Per-bar alert flags: 0 armed short, 1 armed long, 2 filled short, 3 filled long, 4 cancelled,
// 5 target, 6 stop, 7 sweep, 8 confirm
array<bool> fl = array.new_bool(9, false)

var float lastHiP = na
var int   lastHiB = na
var float lastLoP = na
var int   lastLoB = na
var int   lastSpawnBear = na   // tap-1 bar of the last bearish spawn (one sequence per leg)
var int   lastSpawnBull = na

// ───────────────────────── Helpers ─────────────────────────
seqColor(int d) => d == 1 ? bullColor : bearColor

f_col(Seq s) => s.faded ? color.new(seqColor(s.dir), FADE_TR) : seqColor(s.dir)

f_inc(string k) =>
    cnt.put(k, nz(cnt.get(k)) + 1)
    k

// Break of a level in the sequence direction (down for bear, up for bull).
f_brk(int d, float lvl, string mode) =>
    mode == "Close" ? (d == -1 ? close < lvl : close > lvl) : (d == -1 ? low < lvl : high > lvl)

// Bar extreme in the sequence direction (taps 3/5 track it).
f_trendExt(int d) => d == -1 ? low : high

// a lies further in the sequence direction than b.
f_beyond(int d, float a, float b) => d == -1 ? a < b : a > b

// Price reaches a level from the far side (the 50% line, the entry).
f_reach(int d, float lvl) => d == -1 ? high >= lvl : low <= lvl

// Clamp an x coordinate that may point far into the past (e.g. an order armed long ago).
f_xc(int x) => math.max(x, bar_index - MAX_BACK)

// Tap label: lows below the bar, highs above.
f_label(int b, string txt, int d, bool trendSide) =>
    label lb = na
    if DRAW
        dirty.set(0, true)
        lb := label.new(f_xc(b), d == -1 ? low : high, txt, xloc = xloc.bar_index, yloc = (d == -1) == trendSide ? yloc.belowbar : yloc.abovebar, color = color.new(seqColor(d), 100), style = label.style_none, textcolor = seqColor(d), size = lblSize)
    lb

f_hline(int b, float p, int d) =>
    line ln = na
    if DRAW
        ln := line.new(f_xc(b), p, f_xc(b + BRACKET), p, xloc = xloc.bar_index, color = seqColor(d), style = line.style_solid, width = 1)
    ln

// Vertical step at a break.
f_vline(int x, float y1, float y2, color c) =>
    line ln = na
    if DRAW
        ln := line.new(x, y1, x, y2, xloc = xloc.bar_index, color = c, width = 1)
    ln

f_num(float x) => na(x) ? "null" : str.tostring(math.round_to_mintick(x))

// Bar extreme against the sequence direction (a sweep peak: high for a short).
f_cExt(int d) => d == -1 ? high : low

// Limit entry level of a mode: 50% line, or 1 tick beyond tap 4.
f_limitLevel(Seq s, int mode) => mode == 1 ? s.p4 - s.dir * syminfo.mintick : s.mid

// Level whose touch locks tap 5 (the chart mode's limit; confirmation uses the 50% line).
f_entry(Seq s) => f_limitLevel(s, CHART_MODE == 1 ? 1 : 0)

// Target per targetMode from tap 5 or the risk.
f_tgtFrom(int d, float p5, float e, float risk) => targetMode == "Tap 5" ? p5 : targetMode == "Tap 5 + ext" ? p5 + d * targetExtTicks * syminfo.mintick : e + d * fixedR * risk

// Chart levels at arming. Confirmation has no entry or stop until the confirmation.
f_levels(Seq s) =>
    if CHART_MODE < 2
        float e  = f_limitLevel(s, CHART_MODE)
        float st = s.p2 - s.dir * stopBufferATR * nz(atr)
        s.entryP := e
        s.stopP  := st
        s.tgtP   := f_tgtFrom(s.dir, s.p5, e, math.abs(st - e))
    else
        s.entryP := na
        s.stopP  := na
        s.tgtP   := f_tgtFrom(s.dir, s.p5, na, na)
    s

// Target only (entry and stop stay fixed once armed).
f_target(Seq s) =>
    s.tgtP := targetMode == "Fixed R" ? s.tgtP : f_tgtFrom(s.dir, s.p5, na, na)
    s

// Tap 5 follows a new extreme; returns true if it moved.
f_trail5(Seq s) =>
    float ex = f_trendExt(s.dir)
    bool  mv = f_beyond(s.dir, ex, s.p5)
    if mv
        s.p5 := ex
        s.b5 := bar_index
        label.set_x(s.l5, s.b5)
        line.set_xy1(s.h5, s.b5, s.p5)
        line.set_xy2(s.h5, s.b5 + BRACKET, s.p5)
        line.set_y2(s.v5, s.p5)
        line.set_xy1(s.lq5, s.b5, s.p5)
        line.set_y2(s.lq5, s.p5)
        dirty.set(0, true)
    mv

// Tap 5 ran more than maxTap5Ext zone heights beyond mid.
f_runaway(Seq s) => math.abs(s.mid - s.p5) > maxTap5Ext * math.abs(s.p2 - s.p1)

f_alert(string ev, Seq s, string reason) =>
    string msg = '{"event":"' + ev + '","dir":"' + (s.dir == 1 ? "long" : "short") + '","mode":"' + entryMode + '","entry":' + f_num(s.entryP) + ',"stop":' + f_num(s.stopP) + ',"target":' + f_num(s.tgtP) + (reason != "" ? ',"reason":"' + reason + '"' : "") + (ev == "sweep" or ev == "confirm" ? ',"peak":' + f_num(s.peak) + ',"cl":' + f_num(s.cl) : "") + (ev == "armed" or ev == "confirm" ? ',"rr":' + (na(s.rr) ? "null" : str.tostring(s.rr, "0.00")) + ',"optional":' + (s.opt ? "true" : "false") : "") + ',"symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period + '"}'
    if not s.hidden
        alert(msg, alert.freq_once_per_bar_close)
    s

// Freeze or extend the zone box and its FVG box.
f_zoneRight(Seq s, int x) =>
    box.set_right(s.zone, x)
    box.set_right(s.fvgBox, x)
    s

// Recalculate mid and move the zone drawings after tap 2 changes.
f_setZone(Seq s) =>
    s.mid := (s.p1 + s.p2) / 2
    box.set_top(s.zone, math.max(s.p1, s.p2))
    box.set_bottom(s.zone, math.min(s.p1, s.p2))
    line.set_y1(s.midLn, s.mid)
    line.set_y2(s.midLn, s.mid)
    label.set_x(s.l2, s.b2)
    line.set_xy1(s.h2, s.b2, s.p2)
    line.set_xy2(s.h2, s.b2 + BRACKET, s.p2)
    line.set_xy1(s.lq2, f_xc(s.b2), s.p2)
    line.set_y2(s.lq2, s.p2)
    dirty.set(0, true)
    s

f_tradeLine(line ln, label lb, int x1, int x2, float p, string txt, string sfx, color c, string sty) =>
    line  l   = ln
    label lb2 = lb
    string t  = txt + " " + str.tostring(p, format.mintick) + sfx
    if na(l)
        l   := line.new(f_xc(x1), p, x2, p, xloc = xloc.bar_index, color = c, style = sty, width = 1)
        lb2 := label.new(x2, p, t, xloc = xloc.bar_index, color = color.new(c, 100), style = label.style_label_left, textcolor = c, size = size.tiny)
    else
        line.set_xy1(l, f_xc(x1), p)
        line.set_xy2(l, x2, p)
        line.set_color(l, c)
        line.set_style(l, sty)
        label.set_xy(lb2, x2, p)
        label.set_text(lb2, t)
        label.set_textcolor(lb2, c)
    [l, lb2]

// Optional setups (R:R out of range or daily limit) get faded, dashed lines.
// Pending confirmation setups have no entry yet, so nothing is drawn until the confirmation.
f_drawTrade(Seq s, int x2) =>
    if showTradeLevels and DRAW and not s.hidden and not na(s.entryP)
        color  c   = s.opt ? color.new(seqColor(s.dir), FADE_TR) : seqColor(s.dir)
        string rrT = na(s.rr) ? "" : str.tostring(s.rr, "0.0") + "R"
        string sfx = s.opt ? " (opt " + (s.optTag == "limit" ? "limit" : rrT) + ")" : (rrT == "" ? "" : " · " + rrT)
        int    x1  = s.state == 5 and CHART_MODE == 2 ? s.b6 : s.armedBar
        [el, eb] = f_tradeLine(s.eLn, s.eLb, x1, x2, s.entryP, s.dir == 1 ? "Long" : "Short", sfx, c, s.opt ? line.style_dashed : line.style_solid)
        [sl, sb] = f_tradeLine(s.sLn, s.sLb, na(s.stopX) ? x1 : s.stopX, x2, s.stopP, "Stop", "", c, s.opt ? line.style_dashed : line.style_dotted)
        [tl, tb] = f_tradeLine(s.tLn, s.tLb, x1, x2, s.tgtP, "Target", "", c, line.style_dashed)
        s.eLn := el
        s.eLb := eb
        s.sLn := sl
        s.sLb := sb
        s.tLn := tl
        s.tLb := tb
    s

f_delTrade(Seq s) =>
    line.delete(s.eLn)
    line.delete(s.sLn)
    line.delete(s.tLn)
    label.delete(s.eLb)
    label.delete(s.sLb)
    label.delete(s.tLb)
    s.eLn := na
    s.sLn := na
    s.tLn := na
    s.eLb := na
    s.sLb := na
    s.tLb := na
    s

method delAll(Seq s) =>
    label.delete(s.l1)
    label.delete(s.l2)
    label.delete(s.l3)
    label.delete(s.l4)
    label.delete(s.l5)
    label.delete(s.l6)
    label.delete(s.lDot)
    label.delete(s.lDbg)
    line.delete(s.h1)
    line.delete(s.h2)
    line.delete(s.h3)
    line.delete(s.h4)
    line.delete(s.h5)
    line.delete(s.v3)
    line.delete(s.v5)
    box.delete(s.zone)
    line.delete(s.midLn)
    line.delete(s.lq2)
    line.delete(s.lq4)
    line.delete(s.lq5)
    line.delete(s.lqC)
    box.delete(s.fvgBox)
    if not na(s.oldStops)
        for ln in s.oldStops
            line.delete(ln)
    f_delTrade(s)
    dirty.set(0, true)
    s

f_fade(Seq s) =>
    s.faded := true
    color c  = f_col(s)
    color cz = color.new(seqColor(s.dir), FADE_ZT)
    label.set_textcolor(s.l1, c)
    label.set_textcolor(s.l2, c)
    label.set_textcolor(s.l3, c)
    label.set_textcolor(s.l4, c)
    label.set_textcolor(s.l5, c)
    label.set_textcolor(s.l6, c)
    label.set_color(s.lDot, c)
    line.set_color(s.h1, c)
    line.set_color(s.h2, c)
    line.set_color(s.h3, c)
    line.set_color(s.h4, c)
    line.set_color(s.h5, c)
    line.set_color(s.v3, c)
    line.set_color(s.v5, c)
    line.set_color(s.midLn, c)
    line.set_color(s.lq2, color.new(seqColor(s.dir), 80))
    line.set_color(s.lq4, color.new(seqColor(s.dir), 80))
    line.set_color(s.lq5, color.new(seqColor(s.dir), 80))
    line.set_color(s.lqC, color.new(color.gray, 70))
    s.lq2On := false
    s.lq4On := false
    s.lq5On := false
    box.set_bgcolor(s.zone, cz)
    box.set_border_color(s.zone, cz)
    box.set_bgcolor(s.fvgBox, color.new(FVG_COL, 94))
    dirty.set(0, true)
    s

// Latest tap reached (for the debug reason label).
f_lastTap(Seq s) =>
    int   b = s.b2
    float p = s.p2
    if not na(s.b5)
        b := s.b5
        p := s.p5
    else if not na(s.b4)
        b := s.b4
        p := s.p4
    else if not na(s.b3)
        b := s.b3
        p := s.p3
    [b, p]

// Cancel before fill: pull trade lines, freeze, fade (or delete), log the reason.
// A hidden (shadow) sequence just stops; it has no drawings or alerts.
f_cancel(Seq s, string reason) =>
    if s.hidden
        s.state  := 6
        s.result := reason
    else
        bool wasArmed = s.state == 4
        bool keep     = keepCancelled and (s.state > 0 or debugMode)
        f_inc("cancelled")
        f_inc(reason)
        if wasArmed
            f_alert("cancelled", s, reason)
            fl.set(4, true)
        s.state  := 6
        s.result := reason
        f_delTrade(s)
        f_zoneRight(s, bar_index)
        line.set_x2(s.midLn, bar_index)
        if keep
            f_fade(s)
            if debugMode
                [lb, lp] = f_lastTap(s)
                if DRAW
                    s.lDbg := label.new(f_xc(lb), lp, reason, xloc = xloc.bar_index, color = color.new(color.gray, 100), style = label.style_label_left, textcolor = color.gray, size = size.tiny)
            hist.push(s)
        else
            s.delAll()
    s

f_nullDraw(Seq s) =>
    s.l1    := na
    s.l2    := na
    s.l3    := na
    s.l4    := na
    s.l5    := na
    s.l6    := na
    s.lDot  := na
    s.lDbg  := na
    s.h1    := na
    s.h2    := na
    s.h3    := na
    s.h4    := na
    s.h5    := na
    s.v3    := na
    s.v5    := na
    s.zone  := na
    s.midLn := na
    s.eLn   := na
    s.sLn   := na
    s.tLn   := na
    s.eLb   := na
    s.sLb   := na
    s.tLb   := na
    s.lq2   := na
    s.lq4   := na
    s.lq5   := na
    s.lqC   := na
    s.oldStops := na
    s.fvgBox := na
    s

// Shadow tag on a visible sequence: the chart shows the Enforce view (a faded,
// cancelled copy keeps the drawings) while the sequence itself runs on hidden.
f_hide(Seq s, string reason) =>
    Seq v = s.copy()
    v.state  := 6
    v.result := reason
    f_inc("cancelled")
    f_inc(reason)
    if s.state == 4
        f_alert("cancelled", s, reason)
        fl.set(4, true)
    f_delTrade(v)
    f_zoneRight(v, bar_index)
    line.set_x2(v.midLn, bar_index)
    if keepCancelled
        f_fade(v)
        if debugMode
            [lb, lp] = f_lastTap(v)
            if DRAW
                v.lDbg := label.new(f_xc(lb), lp, reason + " (shadow)", xloc = xloc.bar_index, color = color.new(color.gray, 100), style = label.style_label_left, textcolor = color.gray, size = size.tiny)
        hist.push(v)
    else
        v.delAll()
    s.hidden := true
    f_nullDraw(s)
    s

// Invented filter fi. Enforce cancels; Shadow tags once (and hides a visible
// sequence) but lets it run; Off does nothing. Returns true when cancelled.
f_filter(Seq s, int fi) =>
    string mode   = FMODES.get(fi)
    string filt   = FNAMES.get(fi)
    bool   killed = false
    if mode == "Enforce"
        f_cancel(s, filt)
        killed := true
    else if mode == "Shadow" and not s.tags.get(fi)
        s.tags.set(fi, true)
        if na(s.tagBar)
            s.tagBar := bar_index
        f_inc("tag." + filt)
        if not s.hidden
            f_hide(s, filt)
    killed

f_addf(string k, float v) =>
    fs.put(k, nz(fs.get(k)) + v)
    k

f_bucket4(float x) => na(x) ? -1 : x < 1 ? 0 : x < 2 ? 1 : x < 3 ? 2 : 3

f_rrBucket(float x) => na(x) ? -1 : x < 1.5 ? 0 : x < 2 ? 1 : x < 3 ? 2 : x < 5 ? 3 : 4

// Bit i of a tag mask (no bitwise operators in Pine).
f_has(int mask, int i) => int(math.floor(mask / math.pow(2, i))) % 2 == 1

// Running R curve for a stats prefix: count, sum, peak-to-trough drawdown.
f_curve(string p, float r) =>
    f_addf(p + ".n", 1)
    f_addf(p + ".sum", r)
    float cum = nz(fs.get(p + ".cum")) + r
    fs.put(p + ".cum", cum)
    fs.put(p + ".peak", math.max(nz(fs.get(p + ".peak")), cum))
    fs.put(p + ".dd", math.max(nz(fs.get(p + ".dd")), fs.get(p + ".peak") - cum))
    p

f_t(int t) => na(t) ? "" : str.format_time(t, "yyyy-MM-dd HH:mm", "America/New_York")

// Session of the current bar in New York time: 0 NY 09:30–16:00, 1 London 03:00–09:30, 2 Asia.
f_session() =>
    int m = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
    m >= 570 and m < 960 ? 0 : m >= 180 and m < 570 ? 1 : 2

// ───────────────────────── Trailing stop (v3.2) ─────────────────────────
f_trailNew(float stop) => Trail.new(array.new_float(), na, stop, stop)

// After a mini break of structure in the trade direction (price beyond the last post-entry
// pivot) and once trailStartR in favor, move the stop to the second-latest ("one swing
// behind") or latest post-entry stop-side pivot plus a buffer. Stops only move in favor.
f_trailStep(Trail tr, int d, int bFill, float mfeR) =>
    float sp = d == -1 ? tPH : tPL
    float bp = d == -1 ? tPL : tPH
    if tPB > bFill
        if not na(sp)
            tr.piv.push(sp)
            if tr.piv.size() > 6
                tr.piv.shift()
        if not na(bp)
            tr.bos := bp
    if not na(tr.bos) and f_beyond(d, f_trendExt(d), tr.bos) and mfeR >= trailStartR
        int   n   = tr.piv.size()
        float buf = trailBufferATR * nz(atr)
        if n >= 2
            float lv1 = tr.piv.get(n - 2) - d * buf
            if f_beyond(d, lv1, tr.sOne) and f_beyond(d, close, lv1)
                tr.sOne := lv1
        if n >= 1
            float lv2 = tr.piv.get(n - 1) - d * buf
            if f_beyond(d, lv2, tr.sLatest) and f_beyond(d, close, lv2)
                tr.sLatest := lv2
        tr.bos := na
    tr

// Chart trade stop under trailMode.
f_trailStop(Seq s) => trailMode == "One behind" ? s.tr.sOne : trailMode == "Latest" ? s.tr.sLatest : s.stop0

// The chart stop moved: leave a faded segment at the old level, start the stop line here.
f_stopMoved(Seq s, float newStop) =>
    if showTradeLevels and DRAW and not s.hidden
        if na(s.oldStops)
            s.oldStops := array.new<line>()
        s.oldStops.push(line.new(f_xc(nz(s.stopX, s.b6)), s.stopP, bar_index, s.stopP, xloc = xloc.bar_index, color = color.new(seqColor(s.dir), 70), style = line.style_dotted, width = 1))
        if s.oldStops.size() > 6
            line.delete(s.oldStops.shift())
    s.stopP := newStop
    s.stopX := bar_index
    s

// ───────────────────────── Liquidity lines (v3.2) ─────────────────────────
f_liqLine(int b, float p, color c) =>
    line ln = na
    if DRAW and showLiquidityLines
        ln := line.new(f_xc(b), p, bar_index, p, xloc = xloc.bar_index, color = c, width = 1)
    ln

// Extend the live lines; a line ends when price trades through it (tap 2 from tap 3 on,
// tap 4 once tap 5 exists, tap 5 after the fill).
f_liqStep(Seq s) =>
    int d = s.dir
    if s.lq2On
        line.set_x2(s.lq2, bar_index)
        if s.state >= 1 and f_beyond(-d, f_cExt(d), s.p2)
            s.lq2On := false
    if s.lq4On
        line.set_x2(s.lq4, bar_index)
        if s.state >= 3 and f_beyond(-d, f_cExt(d), s.p4)
            s.lq4On := false
    if s.lq5On
        line.set_x2(s.lq5, bar_index)
        if s.state == 5 and f_beyond(d, f_trendExt(d), s.p5)
            s.lq5On := false
    s

// ───────────────────────── Exit variants ─────────────────────────
// CSV trade log line, one per entry mode per filled trade (header printed on the first bar).
f_csv(Trk t) =>
    Seq    s    = t.s
    string tags = ""
    for fi = 0 to NF - 1
        if s.tags.get(fi)
            tags += (tags == "" ? "" : "|") + FNAMES.get(fi)
    if s.optRR
        tags += (tags == "" ? "" : "|") + "rr"
    if s.optTag == "limit"
        tags += (tags == "" ? "" : "|") + "limit"
    float  zh  = math.abs(s.p2 - s.p1)
    string res = ""
    for v = 0 to NV - 1
        res += "," + str.tostring(t.xr.get(v), "0.000")
    string ln = str.tostring(s.id) + "," + MNAMES.get(t.mode) + "," + (s.dir == 1 ? "long" : "short") + "," + f_t(s.tSpawn) + "," + f_t(s.tArm) + "," + f_t(t.tFill) + "," + f_t(t.tExit)
    ln += "," + f_num(t.entryP) + "," + f_num(t.stopP) + "," + f_num(t.tgtP) + "," + f_num(t.risk0) + "," + str.tostring(t.rr, "0.00")
    ln += "," + str.tostring(s.zoneATR, "0.00") + "," + str.tostring(zh > 0 ? math.abs(t.p5 - s.mid) / zh : na, "0.00") + "," + str.tostring(t.bFill - s.armedBar)
    ln += "," + (t.sess == 0 ? "NY" : t.sess == 1 ? "London" : "Asia") + "," + tags + "," + f_num(t.peak) + "," + f_num(t.cl)
    ln += "," + f_num(s.fvgTop) + "," + f_num(s.fvgBot) + "," + t.fvgTag + res
    ln += "," + str.tostring(t.risk0 > 0 ? t.mfe / t.risk0 : na, "0.000") + "," + str.tostring(t.risk0 > 0 ? t.mae / t.risk0 : na, "0.000")
    log.info(ln)
    t

// One exit variant resolved. Chart-view trades feed the entry and exit tables; every trade is logged.
f_xdone(Trk t, int v, float r) =>
    t.xr.set(v, r)
    t.xopen := t.xopen - 1
    if v == 0
        t.tExit := time
    if t.vis
        float usd = (r * t.risk0 * syminfo.pointvalue - 2 * commissionPerSide) * contracts
        for p in array.from("m" + str.tostring(t.mode) + ".x" + str.tostring(v), t.chart ? "x" + str.tostring(v) : "")
            if p != ""
                f_curve(p, r)
                if r > 0
                    f_addf(p + ".nW", 1)
                    f_addf(p + ".w", r)
                else if r < 0
                    f_addf(p + ".l", -r)
                f_addf(p + ".usd", usd)
        if v == 0
            array<float> A = t.mode == 0 ? mRA0 : t.mode == 1 ? mRA1 : mRA2
            A.push(r)
    if t.xopen == 0 and debugLog
        f_csv(t)
    t

f_xinit(Trk t) =>
    float e = t.entryP
    float k = t.risk0
    int   d = t.s.dir
    t.xs    := array.new_float(NV, t.stopP)
    t.xt    := array.from(t.tgtP, e + d * 1.5 * k, e + d * 2.0 * k, e + d * 3.0 * k, t.tgtP, t.tgtP, t.tgtP, e + d * 4.0 * k, e + d * 5.0 * k, e + d * 3.0 * k, e + d * 3.0 * k, t.tgtP)
    t.xr    := array.new_float(NV, na)
    t.xrem  := array.new_float(NV, 1.0)
    t.xbank := array.new_float(NV, 0.0)
    t.xopen := NV
    t

// Exit variants on one bar after the fill. Stop is checked first (same bar = stop);
// stop moves and the partial take effect from the next bar.
//   A tap 5   B 1.5R   C 2R   D 3R   E tap 5, BE at 1R   F tap 5, BE at 1.5R   G half at 1R, BE, rest to tap 5
//   H 4R   I 5R   J 3R + trail one behind   K 3R + trail latest   L tap 5 + trail one behind
f_xstep(Trk t) =>
    int   d   = t.s.dir
    float fav = (d == -1 ? t.entryP - low : high - t.entryP) / t.risk0
    for v = 0 to NV - 1
        if na(t.xr.get(v))
            float st = t.xs.get(v)
            float tg = t.xt.get(v)
            bool  hs = d == -1 ? high >= st : low <= st
            bool  ht = d == -1 ? low <= tg : high >= tg
            if hs
                f_xdone(t, v, t.xbank.get(v) + t.xrem.get(v) * d * (st - t.entryP) / t.risk0)
            else if ht
                f_xdone(t, v, t.xbank.get(v) + t.xrem.get(v) * d * (tg - t.entryP) / t.risk0)
            else if (v == 4 and fav >= 1.0) or (v == 5 and fav >= 1.5)
                t.xs.set(v, t.entryP)
            else if v == 6 and t.xrem.get(v) == 1.0 and fav >= 1.0
                t.xbank.set(v, 0.5)
                t.xrem.set(v, 0.5)
                t.xs.set(v, t.entryP)
    f_trailStep(t.tr, d, t.bFill, t.mfe / t.risk0)
    for v = 9 to 11
        if na(t.xr.get(v))
            float cand = v == 10 ? t.tr.sLatest : t.tr.sOne
            if f_beyond(d, cand, t.xs.get(v))
                t.xs.set(v, cand)
    t

// ───────────────────────── FVG inside the zone (v3.3) ─────────────────────────
// At the tap 3 break: scan every 3-candle window between the tap 2 bar and the break for a
// gap in the leg's direction (bearish: low two bars back above this bar's high), clip it to
// the zone, keep it if at least minFvgTicks tall, and pick the one closest to mid (ties: earlier).
f_fvgFind(Seq s) =>
    int   d    = s.dir
    float top  = math.max(s.p1, s.p2)
    float bot  = math.min(s.p1, s.p2)
    int   oNew = bar_index - s.brk3
    int   oOld = math.min(bar_index - s.b2 - 2, oNew + 300)
    float best = na
    if oOld >= oNew
        for o = oNew to oOld
            float gTop = d == -1 ? low[o + 2] : low[o]
            float gBot = d == -1 ? high[o] : high[o + 2]
            if gTop > gBot
                float ct = math.min(gTop, top)
                float cb = math.max(gBot, bot)
                if ct - cb >= minFvgTicks * syminfo.mintick
                    float dist = math.abs((ct + cb) / 2 - s.mid)
                    if na(best) or dist <= best
                        best     := dist
                        s.fvgTop := ct
                        s.fvgBot := cb
                        s.fvgBar := bar_index - o - 2
    s

f_fvgDraw(Seq s) =>
    if DRAW and showFVG and not s.hidden and not na(s.fvgTop)
        s.fvgBox := box.new(f_xc(s.fvgBar), s.fvgTop, bar_index, s.fvgBot, xloc = xloc.bar_index, border_color = color.new(FVG_COL, 100), border_width = 0, bgcolor = color.new(FVG_COL, 85))
    s

// FVG tag of a tracker at its fill.
f_fvgTagOf(Trk t) => na(t.s.fvgTop) ? 0 : t.fvgT ? 2 : t.fvgMit ? 3 : 1

// Reasons that belong to one entry mode and do not end the other modes' trackers.
f_ownReason(string r) => r == "close>2" or r == "noconf" or r == "tinyR" or r == "session" or r == "requireFVG" or r == "nofvg" or r == "fvgmit"

// ───────────────────────── Chart trade ─────────────────────────
// Trade result. Visible trades feed the chart stats; every trade (visible or shadow) is
// recorded for the filter impact table. With a trailed stop a "stop" can be a winner.
f_finish(Seq s, string res) =>
    float risk = s.risk0
    float pts  = s.dir * ((res == "target" ? s.tgtP : s.stopP) - s.entryP)   // per contract
    float r    = risk > 0 ? pts / risk : 0.0
    bool  win  = r > 0
    float zh   = math.abs(s.p2 - s.p1)
    s.state  := 6
    s.result := res
    int mask = s.optRR ? int(math.pow(2, NF)) : 0
    for fi = 0 to NF - 1
        if s.tags.get(fi)
            mask += int(math.pow(2, fi))
    trR.push(r)
    trMask.push(mask)
    trRRb.push(f_rrBucket(s.rr))
    trSess.push(s.sess)
    trExt.push(f_bucket4(zh > 0 ? math.abs(s.p5 - s.mid) / zh : na))
    trZh.push(f_bucket4(s.zoneATR))
    int a2f = s.b6 - s.armedBar
    trA2F.push(a2f <= 10 ? 0 : a2f <= 40 ? 1 : 2)
    trFvg.push(math.max(0, FVGTAGS.indexof(s.fvgTag)))
    if not s.hidden
        f_inc(res)
        visR.push(r)
        if res == "target"
            winMAE.push(risk > 0 ? s.mae / risk : 0.0)
        else
            stopMFE.push(risk > 0 ? s.mfe / risk : 0.0)
        // Magnitude stats: totals and per direction (".L" / ".S").
        for sfx in array.from("", s.dir == 1 ? ".L" : ".S")
            f_addf("n" + sfx, 1)
            f_addf((win ? "nW" : "nL") + sfx, 1)
            f_addf((win ? "winR" : "lossR") + sfx, math.abs(r))
        f_addf("pts", pts * contracts)
        f_addf("usd", (pts * syminfo.pointvalue - 2 * commissionPerSide) * contracts)
        float cum = nz(fs.get("cum")) + r
        fs.put("cum", cum)
        fs.put("peak", math.max(nz(fs.get("peak")), cum))
        fs.put("dd", math.max(nz(fs.get("dd")), fs.get("peak") - cum))
        fs.put("streak", r < 0 ? nz(fs.get("streak")) + 1 : 0.0)
        fs.put("maxStreak", math.max(nz(fs.get("maxStreak")), fs.get("streak")))
        if win
            fs.put("bigWin", math.max(nz(fs.get("bigWin")), r))
        else
            f_addf("mfeStop", risk > 0 ? s.mfe / risk : 0.0)
        // Daily loss limit: only non-optional trades count (optional ones would be skipped).
        if not s.opt
            f_curve("dn", r)
            if not s.ex2
                f_curve("d2", r)
            if not s.ex3
                f_curve("d3", r)
            if r < 0
                day.set(1, day.get(1) + 1)
                if not s.ex2
                    day.set(2, day.get(2) + 1)
                if not s.ex3
                    day.set(3, day.get(3) + 1)
        f_alert(res, s, "")
        fl.set(res == "target" ? 5 : 6, true)
        f_delTrade(s)
        f_fade(s)
        hist.push(s)
    s

// The chart tracker filled: copy its levels to the sequence, draw, alert.
// Limit modes: "6" and a dot at the fill. Confirmation: "6" already sits on the sweep peak; a dot marks the entry.
f_fill(Seq s, Trk t) =>
    color c = seqColor(s.dir)
    s.entryP := t.entryP
    s.stopP  := t.stopP
    s.stop0  := t.stopP
    s.tgtP   := t.tgtP
    s.risk0  := t.risk0
    s.tr     := f_trailNew(t.stopP)
    s.stopX  := bar_index
    s.state  := 5
    s.b6     := bar_index
    s.sess   := t.sess
    s.fvgTag := t.fvgTag
    if CHART_MODE == 2
        s.rr    := t.rr
        s.optRR := not na(s.rr) and (s.rr < minRR or (maxRR > 0 and s.rr > maxRR))
        s.opt   := s.opt or s.optRR
        if s.optRR
            f_inc("tag.rr")
            if s.optTag == ""
                s.optTag := "rr"
    if not s.hidden
        if DRAW
            if CHART_MODE < 2
                s.l6 := label.new(bar_index, s.entryP, "6", xloc = xloc.bar_index, color = color.new(c, 100), style = s.dir == -1 ? label.style_label_down : label.style_label_up, textcolor = c, size = lblSize)
            s.lDot := label.new(bar_index, s.entryP, "", xloc = xloc.bar_index, color = c, style = label.style_circle, size = size.tiny)
        f_zoneRight(s, bar_index)
        line.set_x2(s.midLn, bar_index)
        line.set_x2(s.h4, f_xc(math.min(s.b4 + BRACKET, bar_index)))
        line.set_x2(s.lqC, bar_index)
        s.lq4On := false
        f_drawTrade(s, bar_index + BRACKET)
        f_inc("filled")
        acc.set(1, acc.get(1) + (bar_index - s.armedBar))
        f_alert(CHART_MODE == 2 ? "confirm" : "filled", s, "")
        fl.set(s.dir == 1 ? 3 : 2, true)
        if CHART_MODE == 2
            fl.set(8, true)
        // Daily-limit test: skipped if the day's limit was already reached (optional trades are always skipped).
        s.ex2 := s.opt or day.get(2) >= 2
        s.ex3 := s.opt or day.get(3) >= 3
    trades.push(s)
    // A limit fill bar that also touched the stop (order unknown -> assume stop).
    if CHART_MODE < 2 and (s.dir == -1 ? high >= s.stopP : low <= s.stopP)
        f_finish(s, "stop")
    s

// Tap 5 locked: chart levels, planned R:R and the optional flag (limit modes), and one
// entry tracker per mode. A hidden sequence never supersedes a visible one.
f_arm(Seq s) =>
    bool  killed = false
    float zh     = math.abs(s.p2 - s.p1)
    if extMinMode != "Off" and zh > 0 and math.abs(s.p5 - s.mid) / zh < minTap5Ext
        killed := f_filter(s, F_EXTMIN)
    if not killed
        s.state    := 4
        s.armedBar := bar_index
        s.tArm     := time
        f_levels(s)
        float risk = math.abs(s.entryP - s.stopP)
        bool  lim  = dailyMode == "Enforce" and day.get(1) >= dailyMaxLosses
        s.rr     := risk > 0 ? math.abs(s.tgtP - s.entryP) / risk : na
        s.optRR  := not na(s.rr) and (s.rr < minRR or (maxRR > 0 and s.rr > maxRR))
        s.opt    := s.optRR or lim
        s.optTag := lim ? "limit" : s.optRR ? "rr" : ""
        if s.optRR
            f_inc("tag.rr")
        if supMode != "Off"
            for o in active
                if o.id != s.id and o.dir == s.dir and o.state == 4 and (not s.hidden or o.hidden)
                    f_filter(o, F_SUP)
            for o in shadow
                if o.id != s.id and o.dir == s.dir and o.state == 4
                    f_filter(o, F_SUP)
        for m = 0 to NM - 1
            trks.push(Trk.new(s = s, mode = m, chart = m == CHART_MODE, p5 = s.p5, stopL = s.p2 - s.dir * stopBufferATR * nz(atr), fp = array.new_float(), fb = array.new_int()))
            if not s.hidden
                f_inc("m" + str.tostring(m) + ".armed")
        if not s.hidden
            f_inc("armed")
            f_alert("armed", s, "")
            fl.set(s.dir == 1 ? 1 : 0, true)
    s

// ───────────────────────── Entry trackers ─────────────────────────
// A tracker ended without a fill. The chart tracker takes its sequence with it.
f_tend(Trk t, string why) =>
    t.st  := 3
    t.why := why
    if t.chart and t.s.state == 4
        f_cancel(t.s, why)
    t

// Fill a tracker at e with stop st. touchBar: a limit fill, whose bar may also have touched the stop.
f_tfill(Trk t, float e, float st, bool touchBar) =>
    Seq   s    = t.s
    int   d    = s.dir
    float risk = math.abs(e - st)
    bool  ok   = true
    if t.mode == 2 and risk < minRiskTicks * syminfo.mintick
        f_tend(t, "tinyR")
        ok := false
    if ok and sessMode != "Off" and f_session() == 0
        if t.chart
            ok := not f_filter(s, F_SESS)
        else if sessMode == "Enforce"
            ok := false
        if not ok
            f_tend(t, "session")
    t.fvgTag := FVGTAGS.get(f_fvgTagOf(t))
    if ok and fvgMode != "Off" and t.fvgTag != "fvg_touched"
        if t.chart
            ok := not f_filter(s, F_FVG)
        else if fvgMode == "Enforce"
            ok := false
        if not ok
            f_tend(t, "requireFVG")
    if ok
        t.entryP := e
        t.stopP  := st
        t.risk0  := risk
        t.tgtP   := f_tgtFrom(d, t.p5, e, risk)
        t.rr     := risk > 0 ? math.abs(t.tgtP - e) / risk : na
        t.bFill  := bar_index
        t.tFill  := time
        t.sess   := f_session()
        t.st     := 2
        t.tr     := f_trailNew(st)
        t.vis    := not s.hidden
        if t.vis
            f_inc("m" + str.tostring(t.mode) + ".fills")
            f_addf("m" + str.tostring(t.mode) + ".risk", risk)
        if risk > 0
            f_xinit(t)
            if touchBar and (d == -1 ? high >= st : low <= st)
                for v = 0 to NV - 1
                    f_xdone(t, v, -1.0)
        if t.chart
            f_fill(s, t)
    ok

// Confirmation level: the latest fractal (in the trade direction) confirmed since the sweep
// started and before the sweep-peak bar; else the extreme between the sweep start and the peak.
f_cl(Trk t, int d) =>
    float cl = na
    if t.fb.size() > 0
        for j = t.fb.size() - 1 to 0
            if t.fb.get(j) < t.peakBar
                cl := t.fp.get(j)
                break
    if na(cl)
        int hiOff = bar_index - t.sweepBar
        int loOff = bar_index - t.peakBar + 1
        if loOff > hiOff
            cl := d == -1 ? low[hiOff] : high[hiOff]
        else
            for i = loOff to hiOff
                float v = d == -1 ? low[i] : high[i]
                cl := na(cl) ? v : d == -1 ? math.min(cl, v) : math.max(cl, v)
    cl

f_chartSweep(Seq s, Trk t) =>
    s.sweepBar := t.sweepBar
    s.peak     := t.peak
    s.cl       := t.cl
    if not s.hidden
        s.l6 := f_label(t.peakBar, "6", s.dir, false)
        if DRAW and showLiquidityLines
            s.lqC := line.new(f_xc(t.sweepBar), t.cl, bar_index, t.cl, xloc = xloc.bar_index, color = color.new(color.gray, LIQ_TR), style = line.style_dashed, width = 1)
        s.lq4On := false
        f_alert("sweep", s, "")
        fl.set(7, true)
    s

f_chartSweepStep(Seq s, Trk t) =>
    s.peak := t.peak
    s.cl   := t.cl
    label.set_x(s.l6, f_xc(t.peakBar))
    line.set_xy1(s.lqC, f_xc(t.sweepBar), t.cl)
    line.set_xy2(s.lqC, bar_index, t.cl)
    dirty.set(0, true)
    s

// One bar of one tracker. Waiting: limit touch (modes 0, 1) or the sweep of tap 4 into the
// zone (mode 2); tap 5 re-trails meanwhile. Sweeping: follow the peak and the confirmation
// level; enter on a close beyond it (or a stop order 1 tick beyond). In trade: exit variants.
f_tstep(Trk t) =>
    Seq s = t.s
    int d = s.dir
    if t.st == 2
        if bar_index > t.bFill and t.xopen > 0
            t.mfe := math.max(t.mfe, d == -1 ? t.entryP - low : high - t.entryP)
            t.mae := math.max(t.mae, d == -1 ? high - t.entryP : t.entryP - low)
            f_xstep(t)
    else if t.st < 2 and bar_index > s.armedBar
        // An enforced cancel of the sequence before its chart fill ends every mode. Reasons
        // every tracker checks for itself or that belong to the chart mode (f_ownReason) do not.
        bool seqDead = s.state == 6 and na(s.b6) and not f_ownReason(s.result)
        // FVG: touched (limit modes: any bar before the fill; confirmation: by the sweep) or
        // closed through first (used up).
        bool  hasF  = not na(s.fvgTop)
        bool  inF   = hasF and (d == -1 ? high >= s.fvgBot : low <= s.fvgTop)
        bool  thru4 = d == -1 ? high > s.p4 : low < s.p4
        float lvl   = sweepLevel == "Zone edge" ? s.p1 : sweepLevel == "50%" ? s.mid : sweepLevel == "FVG" ? (d == -1 ? s.fvgBot : s.fvgTop) : s.p4
        bool  swNow = t.mode == 2 and t.st == 0 and thru4 and (sweepLevel == "FVG" ? inF and not t.fvgMit : f_reach(d, lvl))
        if hasF and not t.fvgT and not t.fvgMit
            if inF and (t.mode < 2 or t.st == 1 or swNow)
                t.fvgT := true
            else if d == -1 ? close > s.fvgTop : close < s.fvgBot
                t.fvgMit := true
        if seqDead
            f_tend(t, s.result)
        else if t.mode < 2 and f_reach(d, f_limitLevel(s, t.mode))
            // A touch fills before a close beyond tap 2 on the same bar counts.
            f_tfill(t, f_limitLevel(s, t.mode), t.stopL, true)
        else if d == -1 ? close > s.p2 : close < s.p2
            f_tend(t, "close>2")
        else if t.mode < 2
            if f_beyond(d, f_trendExt(d), t.p5)
                t.p5 := f_trendExt(d)
        else if t.st == 0
            if sweepLevel == "FVG" and (not hasF or t.fvgMit)
                f_tend(t, hasF ? "fvgmit" : "nofvg")
            else if swNow
                t.st       := 1
                t.sweepBar := bar_index
                t.peak     := f_cExt(d)
                t.peakBar  := bar_index
                t.cl       := f_cl(t, d)
                if t.chart
                    f_chartSweep(s, t)
            else if f_beyond(d, f_trendExt(d), t.p5)
                t.p5 := f_trendExt(d)
        else
            if f_beyond(-d, f_cExt(d), t.peak)
                t.peak    := f_cExt(d)
                t.peakBar := bar_index
            float fr = d == -1 ? cPL : cPH
            if not na(fr) and cPB >= t.sweepBar
                t.fp.push(fr)
                t.fb.push(cPB)
            t.cl := f_cl(t, d)
            float pStop = t.peak - d * stopBufferATR * nz(atr)
            bool  done  = false
            if confBreak == "Close"
                if f_beyond(d, close, t.cl)
                    f_tfill(t, close, pStop, false)
                    done := true
            else if not na(t.clPrev)
                float trig = t.clPrev + d * syminfo.mintick
                if d == -1 ? low <= trig : high >= trig
                    f_tfill(t, d == -1 ? math.min(open, trig) : math.max(open, trig), pStop, false)
                    done := true
            if not done
                if bar_index - t.sweepBar > confExpiryBars
                    f_tend(t, "noconf")
                else
                    t.clPrev := t.cl
                    if t.chart
                        f_chartSweepStep(s, t)
    t

// Spawn a sequence from a confirmed leg. Bars between tap 2 and now (the pivot
// confirmation window) are replayed so a tap-1 break inside it is not missed.
// A zone outside minZoneATR..maxZoneATR is skipped (Enforce), or spawned hidden and tagged (Shadow).
f_spawn(int d, int b1, float p1, int b2, float p2) =>
    float top   = math.max(p1, p2)
    float bot   = math.min(p1, p2)
    float hgt   = top - bot
    bool  small = zoneMode != "Off" and minZoneATR > 0 and (na(atr) or hgt < minZoneATR * atr)
    bool  big   = maxZoneMode != "Off" and not na(atr) and hgt > maxZoneATR * atr
    bool  ghost = (small and zoneMode == "Shadow") or (big and maxZoneMode == "Shadow")
    bool  ok    = hgt > 0 and not (small and zoneMode == "Enforce") and not (big and maxZoneMode == "Enforce")
    Seq s = Seq.new(dir = d, b1 = b1, p1 = p1, b2 = b2, p2 = p2, mid = (p1 + p2) / 2, hidden = ghost, tags = array.new_bool(NF, false), zoneATR = na(atr) or atr == 0 ? na : hgt / atr)
    if ok
        for k = 1 to extLen - 1
            int   i  = extLen - k
            float cl = close[i]
            float lo = low[i]
            float hi = high[i]
            float ex = d == -1 ? lo : hi
            if s.state == 0
                bool brk = breakMode3 == "Close" ? (d == -1 ? cl < p1 : cl > p1) : (d == -1 ? lo < p1 : hi > p1)
                if brk
                    s.state := 1
                    s.brk3  := bar_index - i
                    s.b3    := bar_index - i
                    s.p3    := ex
            else
                bool mit = mitMode == "Close" ? (d == -1 ? cl > s.mid : cl < s.mid) : (d == -1 ? hi >= s.mid : lo <= s.mid)
                if mitMode != "Off" and mit
                    ok := false
                if d == -1 ? lo < s.p3 : hi > s.p3
                    s.p3 := ex
                    s.b3 := bar_index - i
    // Dedupe against same-direction zones in the same pool (visible or shadow).
    array<Seq> pool = ghost ? shadow : active
    array<int> repl = array.new<int>()
    if ok and pool.size() > 0
        for j = 0 to pool.size() - 1
            Seq o = pool.get(j)
            if o.dir == d
                float ot = math.max(o.p1, o.p2)
                float ob = math.min(o.p1, o.p2)
                float ov = math.min(top, ot) - math.max(bot, ob)
                float sm = math.min(hgt, ot - ob)
                if sm > 0 and ov > dedupeOverlap / 100.0 * sm
                    if hgt > ot - ob and o.state == 0
                        repl.push(j)
                    else
                        ok := false
    if ok
        if repl.size() > 0
            for j = repl.size() - 1 to 0
                Seq o = pool.remove(repl.get(j))
                o.delAll()
        // Cap (visible pool): evict the least-advanced candidate, oldest among ties.
        if not ghost and active.size() >= maxActive
            int ix = 0
            for j = 0 to active.size() - 1
                if active.get(j).state < active.get(ix).state
                    ix := j
            Seq ev = active.remove(ix)
            f_cancel(ev, "evict")
        s.id       := nz(cnt.get("_id")) + 1
        s.spawnBar := bar_index
        s.tSpawn   := time
        f_inc("_id")
        if s.state == 1
            f_fvgFind(s)
        if ghost
            s.tagBar := bar_index
            if small and zoneMode == "Shadow"
                s.tags.set(F_MINZ, true)
                f_inc("tag.minZoneATR")
            if big and maxZoneMode == "Shadow"
                s.tags.set(F_MAXZ, true)
                f_inc("tag.maxZoneATR")
        else
            color c = seqColor(d)
            f_inc("spawned")
            s.l1    := f_label(b1, "1", d, true)
            s.l2    := f_label(b2, "2", d, false)
            s.h1    := f_hline(b1, p1, d)
            s.h2    := f_hline(b2, p2, d)
            if DRAW
                s.zone  := box.new(f_xc(b1), top, bar_index, bot, xloc = xloc.bar_index, border_color = color.new(c, ZONE_TR), border_width = 1, bgcolor = color.new(c, ZONE_TR))
                s.midLn := line.new(f_xc(b1), s.mid, bar_index, s.mid, xloc = xloc.bar_index, color = color.new(c, MID_TR), style = line.style_dashed, width = 1)
            s.lq2   := f_liqLine(b2, p2, color.new(c, LIQ_TR))
            s.lq2On := not na(s.lq2)
            if s.state == 1
                line.set_x2(s.h1, f_xc(math.min(b1 + BRACKET, s.brk3)))
                s.l3 := f_label(s.b3, "3", d, true)
                s.h3 := f_hline(s.b3, s.p3, d)
                s.v3 := f_vline(s.brk3, p1, s.p3, c)
                f_fvgDraw(s)
        pool.push(s)
    s

// Stacking: gather the tap 1–5 labels of one sequence.
f_collect(Seq s, array<label> L, array<int> B, array<float> P, array<bool> D, array<int> I, array<string> T, array<color> C) =>
    for k = 1 to 5
        label lb = k == 1 ? s.l1 : k == 2 ? s.l2 : k == 3 ? s.l3 : k == 4 ? s.l4 : s.l5
        if not na(lb)
            L.push(lb)
            B.push(k == 1 ? s.b1 : k == 2 ? s.b2 : k == 3 ? s.b3 : k == 4 ? s.b4 : s.b5)
            P.push(k == 1 ? s.p1 : k == 2 ? s.p2 : k == 3 ? s.p3 : k == 4 ? s.p4 : s.p5)
            D.push((k % 2 == 1) == (s.dir == -1))
            I.push(s.id)
            T.push(str.tostring(k))
            C.push(f_col(s))
    s

// Tap 2 may still move out while waiting for tap 3 (zone expands).
f_tap2(Seq s) =>
    if s.state == 0
        if s.dir == -1 and not na(ePH) and ePH > s.p2 and ePB > s.b2
            s.p2 := ePH
            s.b2 := ePB
            f_setZone(s)
        else if s.dir == 1 and not na(ePL) and ePL < s.p2 and ePB > s.b2
            s.p2 := ePL
            s.b2 := ePB
            f_setZone(s)
    s

// Rank of an armed visible order among same-direction armed orders, oldest first.
f_armRank(Seq s) =>
    int rk = 0
    for o in active
        if o.id != s.id and o.dir == s.dir and o.state == 4 and not o.hidden and (o.armedBar < s.armedBar or (o.armedBar == s.armedBar and o.id < s.id))
            rk += 1
    rk

// Trading day id; the CME day starts 18:00 ET, so shift by 6 h before taking the date.
f_tday() =>
    int t = time + 6 * 3600000
    year(t, "America/New_York") * 10000 + month(t, "America/New_York") * 100 + dayofmonth(t, "America/New_York")

// ───────────────────────── Engine (confirmed bars only) ─────────────────────────
if barstate.isconfirmed
    int tday = f_tday()
    if tday != day.get(0)
        day.set(0, tday)
        day.set(1, 0)
        day.set(2, 0)
        day.set(3, 0)

    if not na(ePH) or not na(ePL)
        for s in active
            f_tap2(s)
        for s in shadow
            f_tap2(s)

    // Spawn: bearish leg = ext low (tap 1) -> ext high (tap 2); bullish is the mirror.
    if not na(ePH) and bias == -1 and not na(lastLoP) and lastLoB < ePB and ePH > lastLoP and lastLoB != nz(lastSpawnBear, -1)
        f_spawn(-1, lastLoB, lastLoP, ePB, ePH)
        lastSpawnBear := lastLoB
    if not na(ePL) and bias == 1 and not na(lastHiP) and lastHiB < ePB and ePL < lastHiP and lastHiB != nz(lastSpawnBull, -1)
        f_spawn(1, lastHiB, lastHiP, ePB, ePL)
        lastSpawnBull := lastHiB
    if not na(ePH)
        lastHiP := ePH
        lastHiB := ePB
    if not na(ePL)
        lastLoP := ePL
        lastLoB := ePB

    // Step visible and shadow candidates (at most one state advance per bar).
    // Sequences hidden during this bar are already in the list and are not stepped twice.
    array<Seq> work = array.concat(active.copy(), shadow.copy())
    for s in work
        if s.state <= 4
            int   d    = s.dir
            color c    = seqColor(d)
            float piv  = d == -1 ? iPH : iPL
            bool  ok4  = not na(piv) and (d == -1 ? piv < s.mid : piv > s.mid) and (not require4InZone or (d == -1 ? piv > s.p1 : piv < s.p1))
            bool  dead = false
            if s.state == 4 and expMode != "Off" and bar_index - s.armedBar > expiryBars
                dead := f_filter(s, F_EXP)

            if not dead
                if biasCancel and biasMode == "Auto" and bias != d and bar_index > s.spawnBar
                    f_cancel(s, "bias")
                else if s.state < 4 and (d == -1 ? close > s.p2 : close < s.p2)
                    // Armed sequences: the entry trackers check this after their own fill.
                    f_cancel(s, "close>2")
                else if (s.state == 1 or s.state == 2) and mitMode != "Off" and bar_index > s.brk3 and (mitMode == "Close" ? (d == -1 ? close > s.mid : close < s.mid) : f_reach(d, s.mid))
                    f_cancel(s, "mid")
                else if s.state == 0
                    // Tap 3: big BOS / sweep of tap 1.
                    if f_brk(d, s.p1, breakMode3)
                        s.state := 1
                        s.brk3  := bar_index
                        s.b3    := bar_index
                        s.p3    := f_trendExt(d)
                        f_fvgFind(s)
                        if not s.hidden
                            line.set_x2(s.h1, f_xc(math.min(s.b1 + BRACKET, bar_index)))
                            s.l3 := f_label(s.b3, "3", d, true)
                            s.h3 := f_hline(s.b3, s.p3, d)
                            s.v3 := f_vline(bar_index, s.p1, s.p3, c)
                            f_fvgDraw(s)
                else if s.state == 1
                    // Tap 3 tracks the extreme until tap 4 forms.
                    float ex = f_trendExt(d)
                    if f_beyond(d, ex, s.p3)
                        s.p3 := ex
                        s.b3 := bar_index
                        label.set_x(s.l3, s.b3)
                        line.set_xy1(s.h3, s.b3, s.p3)
                        line.set_xy2(s.h3, s.b3 + BRACKET, s.p3)
                        line.set_y2(s.v3, s.p3)
                        dirty.set(0, true)
                    // Tap 4: internal pivot after tap 3, on the near side of mid.
                    if ok4 and iPB > s.b3
                        s.state := 2
                        s.p4    := piv
                        s.b4    := iPB
                        if not s.hidden
                            s.l4  := f_label(s.b4, "4", d, false)
                            s.h4  := f_hline(s.b4, s.p4, d)
                            s.lq4 := f_liqLine(s.b4, s.p4, color.new(c, LIQ_TR))
                            s.lq4On := not na(s.lq4)
                else if s.state == 2
                    // A newer qualifying internal pivot replaces tap 4.
                    if ok4 and iPB > s.b4
                        s.p4 := piv
                        s.b4 := iPB
                        label.set_x(s.l4, s.b4)
                        line.set_xy1(s.h4, s.b4, s.p4)
                        line.set_xy2(s.h4, s.b4 + BRACKET, s.p4)
                        line.set_xy1(s.lq4, f_xc(s.b4), s.p4)
                        line.set_y2(s.lq4, s.p4)
                        dirty.set(0, true)
                    // Tap 5: mini BOS through tap 3 -> starts trailing.
                    if f_brk(d, s.p3, breakMode5)
                        s.state := 3
                        s.brk5  := bar_index
                        s.b5    := bar_index
                        s.p5    := f_trendExt(d)
                        if not s.hidden
                            line.set_x2(s.h3, f_xc(math.min(s.b3 + BRACKET, bar_index)))
                            s.l5 := f_label(s.b5, "5", d, true)
                            s.h5 := f_hline(s.b5, s.p5, d)
                            s.v5 := f_vline(bar_index, s.p3, s.p5, c)
                            s.lq5 := f_liqLine(s.b5, s.p5, color.new(c, LIQ_TR))
                            s.lq5On := not na(s.lq5)
                else if s.state == 3
                    // Tap 5 trails the extreme and locks on an opposite internal pivot after it, or a touch of the entry.
                    f_trail5(s)
                    float opp    = d == -1 ? iPH : iPL
                    bool  killed = false
                    if runMode != "Off" and f_runaway(s)
                        killed := f_filter(s, F_RUN)
                    if not killed and ((not na(opp) and iPB > s.b5) or f_reach(d, f_entry(s)))
                        f_arm(s)
                else if s.state == 4
                    // Price ran past the locked tap 5: re-trail it and move the target; entry and stop stay.
                    if f_trail5(s)
                        bool killed = false
                        if runMode != "Off" and f_runaway(s)
                            killed := f_filter(s, F_RUN)
                        if not killed
                            f_target(s)


            if s.state <= 4 and not s.hidden
                f_zoneRight(s, bar_index)
                line.set_x2(s.midLn, bar_index)
                f_liqStep(s)
                // Chart view: an FVG closed through before the sweep (or fill) is used up.
                if not na(s.fvgTop) and not s.fvgMit and na(s.sweepBar) and s.state >= 1 and (d == -1 ? close > s.fvgTop : close < s.fvgBot)
                    s.fvgMit := true
                    box.set_bgcolor(s.fvgBox, color.new(FVG_COL, 95))
                if s.state == 4 and bar_index - s.armedBar >= minArmBars
                    if f_armRank(s) < maxArmedPerDir
                        f_drawTrade(s, bar_index + BRACKET)
                    else
                        f_delTrade(s)

    // Entry trackers: every mode of every armed sequence (the chart mode fills the chart trade).
    for t in trks
        f_tstep(t)

    // Chart trade after the fill: target, stop (trailed per trailMode). Both on one bar -> stop.
    for s in trades
        if s.state == 5 and bar_index > s.b6
            s.mfe := math.max(s.mfe, s.dir == -1 ? s.entryP - low : high - s.entryP)
            s.mae := math.max(s.mae, s.dir == -1 ? high - s.entryP : s.entryP - low)
            bool hitStop = s.dir == -1 ? high >= s.stopP : low <= s.stopP
            bool hitTgt  = s.dir == -1 ? low <= s.tgtP : high >= s.tgtP
            if hitStop
                f_finish(s, "stop")
            else if hitTgt
                f_finish(s, "target")
            else
                f_trailStep(s.tr, s.dir, s.b6, s.risk0 > 0 ? s.mfe / s.risk0 : 0.0)
                float ns = f_trailStop(s)
                if f_beyond(s.dir, ns, s.stopP)
                    f_stopMoved(s, ns)
                if not s.hidden
                    f_liqStep(s)
                f_drawTrade(s, bar_index + BRACKET)

    // Drop sequences that left each list; sequences hidden this bar move to the shadow list.
    if active.size() > 0
        for j = active.size() - 1 to 0
            Seq a = active.get(j)
            if a.state > 4
                active.remove(j)
            else if a.hidden
                active.remove(j)
                shadow.push(a)
    if shadow.size() > 0
        for j = shadow.size() - 1 to 0
            if shadow.get(j).state > 4
                shadow.remove(j)
    // Shadow cap: drop the least-advanced, oldest hidden sequence.
    while shadow.size() > SHADOW_CAP * maxActive
        int ix = 0
        for j = 0 to shadow.size() - 1
            if shadow.get(j).state < shadow.get(ix).state
                ix := j
        shadow.remove(ix)
    if trades.size() > 0
        for j = trades.size() - 1 to 0
            if trades.get(j).state != 5
                trades.remove(j)
    if trks.size() > 0
        for j = trks.size() - 1 to 0
            Trk t = trks.get(j)
            if t.st == 3 or (t.st == 2 and t.xopen <= 0)
                trks.remove(j)
    while trks.size() > TRK_CAP
        trks.shift()
    int nOpen = 0
    for o in trades
        if not o.hidden
            nOpen += 1
    fs.put("maxOpen", math.max(nz(fs.get("maxOpen")), nOpen))
    while hist.size() > keepHistory
        Seq old = hist.shift()
        old.delAll()

    // Stacked labels: same bar, side and price -> one label ("5/3") in the newest sequence's color.
    if dirty.get(0)
        dirty.set(0, false)
        array<label>  L = array.new<label>()
        array<int>    B = array.new<int>()
        array<float>  P = array.new<float>()
        array<bool>   D = array.new<bool>()
        array<int>    I = array.new<int>()
        array<string> T = array.new<string>()
        array<color>  C = array.new<color>()
        for s in active
            f_collect(s, L, B, P, D, I, T, C)
        for s in trades
            f_collect(s, L, B, P, D, I, T, C)
        for s in hist
            f_collect(s, L, B, P, D, I, T, C)
        int n = L.size()
        if n > 0
            for j = 0 to n - 1
                array<int> grp = array.new<int>()
                int newest = j
                for k = 0 to n - 1
                    if B.get(k) == B.get(j) and D.get(k) == D.get(j) and math.abs(P.get(k) - P.get(j)) < syminfo.mintick / 2
                        grp.push(k)
                        if I.get(k) > I.get(newest)
                            newest := k
                string txt = T.get(j)
                color  col = C.get(j)
                if grp.size() > 1
                    if newest != j
                        txt := ""
                    else
                        array<int> ids = array.new<int>()
                        for g in grp
                            ids.push(I.get(g))
                        array<int> ord = ids.sort_indices()
                        txt := ""
                        for o in ord
                            txt := txt + (txt == "" ? "" : "/") + T.get(grp.get(o))
                label.set_text(L.get(j), txt)
                label.set_textcolor(L.get(j), col)

// ───────────────────────── Stats helpers ─────────────────────────
f_pct(float x) => na(x) ? "–" : str.tostring(100 * x, "0.0") + "%"
f_r(float x)   => na(x) ? "–" : (x > 0 ? "+" : "") + str.tostring(x, "0.00") + "R"
f_ratio(float x) => na(x) ? "–" : str.tostring(x, "0.00")

// Count, win rate, expectancy, median R and expectancy without the 5 largest wins.
f_robust(array<float> X) =>
    int   n   = X.size()
    float wr  = na
    float ex  = na
    float md  = na
    float ex5 = na
    if n > 0
        float sum = X.sum()
        int   nW  = 0
        for x in X
            if x > 0
                nW += 1
        array<float> Y = X.copy()
        Y.sort(order.descending)
        int   k   = 0
        float top = 0.0
        for y in Y
            if k < 5 and y > 0
                top += y
                k += 1
        wr  := 1.0 * nW / n
        ex  := sum / n
        md  := X.median()
        ex5 := n - k > 0 ? (sum - top) / (n - k) : na
    [n, wr, ex, md, ex5]
// ==== ENGINE END ====

// ───────────────────────── Orders ─────────────────────────
// The engine above decides when a sequence arms, sweeps, confirms, re-trails or is cancelled;
// the broker emulator decides the fill (limits need 1 tick through) and the exit.
string VKEY = str.substring(exitVariant, 0, 1)
int    VAR  = str.pos("ABCDEFGHIJKL", VKEY)                       // 0 = A … 11 = L
var array<float> VAR_R = array.from(0.0, 1.5, 2.0, 3.0, 0.0, 0.0, 0.0, 4.0, 5.0, 3.0, 3.0, 0.0)   // fixed-R targets (0 = tap 5)

var array<Seq>         ordered  = array.new<Seq>()           // sequences with a live order or an open position
var map<string, float> riskUsd  = map.new<string, float>()   // planned risk in $ per entry id
var map<string, float> pnlAcc   = map.new<string, float>()   // closed P&L per entry id (partials add up)
var array<string>      closing  = array.new<string>()        // entry ids with closed fills, waiting to finalize
var array<float>       stR      = array.new<float>()         // R per finished trade, in exit order
var map<int, float>    monthNet = map.new<int, float>()      // net $ per exit month
var array<int>         sday     = array.new_int(2, 0)        // [trading day, losing trades today]
var array<int>         sc       = array.new_int(2, 0)        // [arms skipped by rules / cap, missed fills]
var int nClosedSeen = 0

f_sid(Seq s) => "6T" + str.tostring(s.id)

f_sessOK() =>
    int ss = f_session()
    sessionMode == "All" ? true : sessionMode == "Skip NY" ? ss != 0 : sessionMode == "London only" ? ss == 1 : ss != 0

// Contracts still open for an entry id.
f_openQty(string id) =>
    float q = 0.0
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            if strategy.opentrades.entry_id(i) == id
                q += math.abs(strategy.opentrades.size(i))
    q

// Entry id among the most recent closed trades (a fill and exit on the same bar is never seen open).
f_closedHas(string id) =>
    bool hit = false
    int  n   = strategy.closedtrades
    if n > 0
        for i = n - 1 to math.max(0, n - 10)
            if strategy.closedtrades.entry_id(i) == id
                hit := true
                break
    hit

// Exit orders for the chosen variant around entry e with initial risk. G: half at 1R, the rest
// to tap 5 with the stop at breakeven after the partial.
f_exits(Seq s, float e, float stop, float risk, bool partialDone) =>
    string id = f_sid(s)
    if VAR == 6
        if not partialDone
            strategy.exit(id + "a", from_entry = id, qty_percent = 50, stop = stop, limit = e + s.dir * risk)
        strategy.exit(id + "b", from_entry = id, stop = partialDone ? e : stop, limit = s.tgtP)
    else
        float tgt = VAR_R.get(VAR) > 0 ? e + s.dir * VAR_R.get(VAR) * risk : s.tgtP
        strategy.exit(id + "x", from_entry = id, stop = stop, limit = tgt)
    s

f_cancelAll(Seq s) =>
    string id = f_sid(s)
    strategy.cancel(id)
    strategy.cancel(id + "x")
    strategy.cancel(id + "a")
    strategy.cancel(id + "b")
    s

// The bar an order decision is made: limit modes at arming, confirmation (close) at the
// confirmation, confirmation (stop order) when the sweep starts. A setup that places no order
// is counted and, with debugOrders, logged with the first rule that blocked it.
f_consider(Seq s) =>
    bool evBar = CHART_MODE < 2 ? (s.state == 4 and s.armedBar == bar_index) : confBreak == "Close" ? (not na(s.b6) and s.b6 == bar_index) : (s.state == 4 and s.sweepBar == bar_index)
    if evBar and not s.hidden and not s.sOrdered
        bool opposite = false
        if not allowOpposite
            for o in ordered
                if o.dir != s.dir and o.sFilled
                    opposite := true
        string why = time < startDate or time > endDate ? "window" : s.opt ? "minRR" : dailyMaxLosses > 0 and sday.get(1) >= dailyMaxLosses ? "daily" : ordered.size() >= maxConcurrent ? "cap" : opposite ? "opposite" : CHART_MODE == 2 and confBreak == "Close" and not f_sessOK() ? "session" : ""
        if why == ""
            s.sOrdered := true
            ordered.push(s)
        else
            sc.set(0, sc.get(0) + 1)
            if debugOrders
                log.info("no order " + f_sid(s) + " " + (s.dir == 1 ? "long" : "short") + " " + f_t(time) + ": " + why)
    s

// The engine filled (a touch the emulator did not fill) or cancelled a still-pending order.
f_drop(Seq s, bool engineFilled) =>
    if engineFilled
        sc.set(1, sc.get(1) + 1)
    f_cancelAll(s)
    riskUsd.remove(f_sid(s))
    s.sDone := true
    s

if barstate.isconfirmed
    int tdayS = f_tday()
    if tdayS != sday.get(0)
        sday.set(0, tdayS)
        sday.set(1, 0)

    // 1) Decide on orders for newly armed / sweeping / confirmed sequences.
    for s in active
        f_consider(s)
    for s in trades
        f_consider(s)

    // 2) Keep orders in step with the engine; manage open positions.
    for s in ordered
        string id    = f_sid(s)
        float  q     = f_openQty(id)
        float  risk  = nz(s.risk0, math.abs(s.entryP - s.stopP))
        float  stop0 = nz(s.stop0, s.stopP)
        bool   engFill = not na(s.b6)
        if not s.sFilled and (q > 0 or f_closedHas(id))
            s.sFilled  := true
            s.sFillBar := bar_index
            riskUsd.put(id, risk * syminfo.pointvalue * contracts)
            s.strl := f_trailNew(stop0)
            if not allowOpposite
                for o in ordered
                    if o.dir != s.dir and not o.sFilled and not o.sDone
                        f_drop(o, false)
        if not s.sDone
            if s.sFilled
                if q > 0
                    if bar_index > s.sFillBar
                        s.sMfe := math.max(s.sMfe, (s.dir == -1 ? s.entryP - low : high - s.entryP) / risk)
                        f_trailStep(s.strl, s.dir, s.sFillBar, s.sMfe)
                    float stp = stop0
                    if (VAR == 4 and s.sMfe >= 1.0) or (VAR == 5 and s.sMfe >= 1.5)
                        stp := s.entryP
                    else if VAR == 9 or VAR == 11
                        stp := s.strl.sOne
                    else if VAR == 10
                        stp := s.strl.sLatest
                    f_exits(s, s.entryP, stp, risk, VAR == 6 and q < contracts)
                else
                    s.sDone := true
            else if CHART_MODE < 2
                // Resting limit, working only in the allowed sessions; the target follows tap 5 re-trails.
                if s.state == 4
                    if f_sessOK()
                        strategy.entry(id, s.dir == 1 ? strategy.long : strategy.short, qty = contracts, limit = s.entryP)
                        f_exits(s, s.entryP, s.stopP, risk, false)
                    else
                        f_cancelAll(s)
                else
                    f_drop(s, engFill)
            else if confBreak == "Close"
                // Confirmation close: market order now, filled at the next open.
                if engFill and s.b6 == bar_index
                    strategy.entry(id, s.dir == 1 ? strategy.long : strategy.short, qty = contracts)
                    f_exits(s, s.entryP, s.stopP, risk, false)
                else
                    f_drop(s, false)
            else
                // Confirmation stop order 1 tick beyond the confirmation level while the sweep runs.
                if s.state == 4 and not na(s.cl) and f_sessOK()
                    float pe = s.cl + s.dir * syminfo.mintick
                    float ps = s.peak - s.dir * stopBufferATR * nz(atr)
                    strategy.entry(id, s.dir == 1 ? strategy.long : strategy.short, qty = contracts, stop = pe)
                    f_exits(s, pe, ps, math.abs(pe - ps), false)
                else if s.state == 4
                    f_cancelAll(s)
                else
                    f_drop(s, engFill)
    if ordered.size() > 0
        for j = ordered.size() - 1 to 0
            if ordered.get(j).sDone
                ordered.remove(j)

    // 3) Closed trades -> R per entry (partial exits of one entry add up).
    if strategy.closedtrades > nClosedSeen
        for i = nClosedSeen to strategy.closedtrades - 1
            string eid = strategy.closedtrades.entry_id(i)
            pnlAcc.put(eid, nz(pnlAcc.get(eid)) + strategy.closedtrades.profit(i))
            if not closing.includes(eid)
                closing.push(eid)
        nClosedSeen := strategy.closedtrades
    if closing.size() > 0
        for j = closing.size() - 1 to 0
            string eid = closing.get(j)
            if f_openQty(eid) == 0
                float ru  = riskUsd.get(eid)
                float pnl = nz(pnlAcc.get(eid))
                if not na(ru) and ru > 0
                    float r = pnl / ru
                    stR.push(r)
                    if r < 0
                        sday.set(1, sday.get(1) + 1)
                    int mk = year(time, "America/New_York") * 100 + month(time, "America/New_York")
                    monthNet.put(mk, nz(monthNet.get(mk)) + pnl)
                closing.remove(j)
                pnlAcc.remove(eid)
                riskUsd.remove(eid)

// ───────────────────────── R table ─────────────────────────
var table rT = na
if barstate.islast
    if na(rT)
        rT := table.new(f_pos(rTablePos), 2, 24, bgcolor = #131722, frame_width = 0, border_width = 0)
    [n, wr, ex, md, ex5] = f_robust(stR)
    float gw  = 0.0
    float gl  = 0.0
    int   nW  = 0
    float cum = 0.0
    float pk  = 0.0
    float dd  = 0.0
    int   stk = 0
    int   mxs = 0
    for r in stR
        if r > 0
            gw += r
            nW += 1
        else
            gl -= r
        cum += r
        pk  := math.max(pk, cum)
        dd  := math.max(dd, pk - cum)
        stk := r < 0 ? stk + 1 : 0
        mxs := math.max(mxs, stk)
    float pf  = gl > 0 ? gw / gl : na
    float net = strategy.netprofit
    float bestMonth = 0.0
    for [k, v] in monthNet
        bestMonth := math.max(bestMonth, v)
    float mShare = net > 0 ? bestMonth / net : na
    bool  pass   = n >= 150 and not na(ex) and ex >= 0.15 and not na(pf) and pf >= 1.3 and not na(mShare) and mShare <= 0.30
    array<string> K = array.from("Engine", "Entry mode", "Exit variant", "Trades", "Win rate", "Avg win", "Avg loss", "Expectancy", "Exp ex top 5 wins", "Median R", "Profit factor (R)", "Max drawdown", "Max consecutive losses", "Net $ (Strategy Tester)", "Best month share of net", "Missed fills (touch, no fill)", "Orders skipped (rules / cap)", "Pass bar (≥150, ≥+0.15R, PF≥1.3, month≤30%)")
    array<string> V = array.from(ENGINE_VERSION, entryMode + (CHART_MODE == 2 ? " · " + confBreak : ""), exitVariant, str.tostring(n), f_pct(wr), f_r(nW > 0 ? gw / nW : na), f_r(n - nW > 0 ? -gl / (n - nW) : na), f_r(ex), f_r(ex5), f_r(md), f_ratio(pf), f_r(-dd), str.tostring(mxs), str.tostring(net, "#,##0.00"), f_pct(mShare), str.tostring(sc.get(1)), str.tostring(sc.get(0)), pass ? "PASS" : "not yet")
    for [i, k] in K
        table.cell(rT, 0, i, k, text_color = #B2B5BE, text_size = tblSize, text_halign = text.align_left)
        table.cell(rT, 1, i, V.get(i), text_color = #B2B5BE, text_size = tblSize, text_halign = text.align_right)
