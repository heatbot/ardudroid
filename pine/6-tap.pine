string confBreak      = input.string("Close", "Confirmation entry", options = ["Close", "Stop order"], group = G_CONF, tooltip = "Close: enter at the close beyond the level (strategy: market at the next open). Stop order: 1 tick beyond the level.")
int    confExpiryBars = input.int(30, "Bars after the sweep to confirm", minval = 1, group = G_CONF)
int    minRiskTicks   = input.int(8, "Min risk (ticks)", minval = 0, group = G_CONF)

string trailMode      = input.string("One behind", "Trail stop", options = ["One behind", "Latest", "Off"], group = G_TRL, tooltip = "After a mini break of structure in the trade direction, move the stop beyond the second-latest (one behind) or latest post-entry swing")
int    trailLen       = input.int(1, "Trail pivot length", minval = 1, group = G_TRL)
float  trailBufferATR = input.float(0.1, "Trail buffer (× ATR 14)", minval = 0, step = 0.05, group = G_TRL)
float  trailStartR    = input.float(1.0, "Start trailing after (R in favor)", minval = 0, step = 0.25, group = G_TRL)

bool   showTradeLevels = input.bool(true, "Show trade levels", group = G_DSP)
int    keepHistory     = input.int(5, "Finished / cancelled sequences to keep", minval = 0, group = G_DSP)
