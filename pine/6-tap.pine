// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// 6-Tap v2.5 — detects and marks the 6-tap sequence (reverse-engineered from the AMN model).
// Bearish model shown in comments; bullish is the exact mirror.
//   Tap 1  external swing low (liquidity)      Tap 2  external swing high (protected)
//   Zone   tap 1 .. tap 2, mid = 50%           Tap 3  big BOS / sweep of tap 1
//   Tap 4  internal lower high below mid       Tap 5  mini BOS through tap 3, trails until locked, re-trails if passed
//   Tap 6  first touch of the entry level after the order is armed

//@version=6
indicator("6-Tap", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 200)

// ───────────────────────── Inputs ─────────────────────────
const string G_BIAS = "Bias"
const string G_STR  = "Structure"
const string G_RULE = "Rules"
const string G_TRD  = "Trade"
const string G_DSP  = "Display"
const string G_FLT  = "Shadow filters"
const string G_DAY  = "Daily loss limit"
const string G_DBG  = "Debug"

string biasMode       = input.string("Auto", "Bias mode", options = ["Auto", "Bullish", "Bearish"], group = G_BIAS)
string biasTF         = input.timeframe("", "Bias timeframe (empty = chart)", group = G_BIAS, tooltip = "Recommended: 1m chart with 5 here. On a 5m chart leave empty.")
int    biasLen        = input.int(15, "Bias pivot length", minval = 2, group = G_BIAS, tooltip = "Swings used for bias only, kept longer than the external pivot length so a zone's own leg does not flip bias")
bool   biasCancel     = input.bool(false, "Cancel sequences when bias flips", group = G_BIAS, tooltip = "Off: bias only filters new sequences; a close beyond tap 2 invalidates")

int    extLen         = input.int(5, "External pivot length", minval = 2, group = G_STR, tooltip = "Taps 1–3 and bias")
int    intLen         = input.int(2, "Internal pivot length", minval = 1, group = G_STR, tooltip = "Taps 4–5 and tap 5 locking")
string breakMode3     = input.string("Wick", "Tap 3 break", options = ["Wick", "Close"], group = G_STR)
string breakMode5     = input.string("Close", "Tap 5 break", options = ["Wick", "Close"], group = G_STR)
float  minZoneATR     = input.float(1.0, "Min zone size (× ATR 14)", minval = 0, step = 0.1, group = G_STR)

bool   require4InZone = input.bool(false, "Tap 4 must be inside the zone", group = G_RULE)
string mitMode        = input.string("Off", "Invalidate if mid is hit before tap 5", options = ["Off", "Close", "Wick"], group = G_RULE)
int    expiryBars     = input.int(40, "Expiry bars after arming", minval = 1, group = G_RULE)
float  maxTap5Ext     = input.float(3.0, "Max tap 5 extension (× zone height from mid)", minval = 0.1, step = 0.1, group = G_RULE)
int    minArmBars     = input.int(1, "Bars armed before trade lines show", minval = 0, group = G_RULE)
int    maxActive      = input.int(10, "Max active sequences", minval = 1, group = G_RULE)
int    dedupeOverlap  = input.int(50, "Dedupe overlap (%)", minval = 0, maxval = 100, group = G_RULE)
int    maxArmedPerDir = input.int(3, "Max armed orders drawn per direction", minval = 1, group = G_RULE, tooltip = "Extra armed orders still count in stats and alerts; their pending lines are not drawn")

string entryLevel     = input.string("50%", "Entry level", options = ["50%", "Tap 4 sweep"], group = G_TRD)
string targetMode     = input.string("Tap 5", "Target mode", options = ["Tap 5", "Tap 5 + ext", "Fixed R"], group = G_TRD)
int    targetExtTicks = input.int(0, "Target extension (ticks)", minval = 0, group = G_TRD)
float  fixedR         = input.float(2.0, "Fixed R", minval = 0.1, step = 0.1, group = G_TRD)
float  stopBufferATR  = input.float(0.1, "Stop buffer (× ATR 14)", minval = 0, step = 0.05, group = G_TRD)
float  minRR          = input.float(1.5, "Min planned R:R (below = optional)", minval = 0, step = 0.1, group = G_TRD)
float  maxRR          = input.float(0.0, "Max planned R:R (above = optional, 0 = off)", minval = 0, step = 0.5, group = G_TRD)

const string FLT_TIP = "Off: rule not applied. Shadow: never cancels; tags the sequence, hides it from the chart and keeps resolving it in the background for the impact table. Enforce: cancels."
string runMode     = input.string("Off", "runaway (max tap 5 extension)", options = ["Off", "Shadow", "Enforce"], group = G_FLT, tooltip = FLT_TIP)
string expMode     = input.string("Off", "expiry (bars after arming)", options = ["Off", "Shadow", "Enforce"], group = G_FLT, tooltip = FLT_TIP)
string supMode     = input.string("Off", "superseded (one armed order per direction)", options = ["Off", "Shadow", "Enforce"], group = G_FLT, tooltip = FLT_TIP)
string zoneMode    = input.string("Shadow", "minZoneATR (min zone size)", options = ["Off", "Shadow", "Enforce"], group = G_FLT, tooltip = FLT_TIP)
string maxZoneMode = input.string("Shadow", "maxZoneATR (max zone size)", options = ["Off", "Shadow", "Enforce"], group = G_FLT, tooltip = FLT_TIP)
float  maxZoneATR  = input.float(3.0, "Max zone size (× ATR 14)", minval = 0.1, step = 0.1, group = G_FLT)
string extMinMode  = input.string("Shadow", "minTap5Ext (min tap 5 extension at arming)", options = ["Off", "Shadow", "Enforce"], group = G_FLT, tooltip = FLT_TIP)
float  minTap5Ext  = input.float(2.0, "Min tap 5 extension (× zone height from mid)", minval = 0, step = 0.1, group = G_FLT)
string sessMode    = input.string("Shadow", "session (skip fills NY 09:30–16:00 ET)", options = ["Off", "Shadow", "Enforce"], group = G_FLT, tooltip = FLT_TIP)

string dailyMode      = input.string("Shadow", "Daily loss limit", options = ["Off", "Shadow", "Enforce"], group = G_DAY, tooltip = "Day starts 18:00 ET; only non-optional trades count. Shadow: no limit vs 2 / 3 losses in the exits table. Enforce: after the limit, new setups that day are drawn as optional (limit).")
int    dailyMaxLosses = input.int(3, "Max losses per day", minval = 1, group = G_DAY)

bool   showTradeLevels = input.bool(true, "Show trade levels", group = G_DSP)
int    keepHistory     = input.int(5, "Finished / cancelled sequences to keep", minval = 0, group = G_DSP)
bool   keepCancelled   = input.bool(true, "Keep cancelled sequences (faded)", group = G_DSP)
color  bullColor       = input.color(#26A69A, "Bullish color", group = G_DSP)
color  bearColor       = input.color(#E5534B, "Bearish color", group = G_DSP)
string labelSize       = input.string("small", "Label size", options = ["tiny", "small", "normal", "large"], group = G_DSP)

bool   debugMode       = input.bool(false, "Debug mode (kill reasons + stats table)", group = G_DBG)
float  commissionPerSide = input.float(0.62, "Commission per side ($ per contract)", minval = 0, step = 0.01, group = G_DBG)
int    contracts       = input.int(1, "Contracts", minval = 1, group = G_DBG)
bool   debugBreakdown  = input.bool(true, "Filter impact table", group = G_DBG)
bool   debugExits      = input.bool(true, "Exit variants table", group = G_DBG)
string statsTablePos   = input.string("top_right", "Stats table position", options = ["top_left", "top_right", "bottom_left", "bottom_right"], group = G_DBG)
string impactTablePos  = input.string("bottom_left", "Impact table position", options = ["top_left", "top_right", "bottom_left", "bottom_right"], group = G_DBG)
string exitsTablePos   = input.string("top_left", "Exits table position", options = ["top_left", "top_right", "bottom_left", "bottom_right"], group = G_DBG)
string tableTextSize   = input.string("tiny", "Table text size", options = ["tiny", "small", "normal"], group = G_DBG)

const int BRACKET = 8    // bars a tap bracket extends to the right
const int ZONE_TR = 88   // zone fill transparency
const int FADE_ZT = 95   // faded zone fill transparency
const int FADE_TR = 60   // faded labels / lines transparency
const int MID_TR  = 30   // 50% line transparency
const int SHADOW_CAP = 5 // hidden sequences kept: SHADOW_CAP × maxActive
const int EXIT_CAP   = 300   // trades whose exit variants are still being resolved
const int NV         = 7     // exit variants A–G

// Shadow filter indices; "rr" (index NF) is the R:R optional flag, reported like a filter.
const int F_RUN    = 0
const int F_EXP    = 1
const int F_SUP    = 2
const int F_MINZ   = 3
const int F_MAXZ   = 4
const int F_EXTMIN = 5
const int F_SESS   = 6
const int NF       = 7
var array<string> FNAMES = array.from("runaway", "expiry", "superseded", "minZoneATR", "maxZoneATR", "minTap5Ext", "session", "rr")
array<string>     FMODES = array.from(runMode, expMode, supMode, zoneMode, maxZoneMode, extMinMode, sessMode, "flag")

// Table corners: a table that asks for a taken corner moves to the next free one.
f_free(string p, string u1, string u2) =>
    array<string> cs = array.from("top_left", "top_right", "bottom_right", "bottom_left")
    string r = p
    if p == u1 or p == u2
        int i0 = cs.indexof(p)
        for k = 1 to 3
            string c = cs.get((i0 + k) % 4)
            if c != u1 and c != u2
                r := c
                break
    r
f_pos(string p) => p == "top_left" ? position.top_left : p == "top_right" ? position.top_right : p == "bottom_left" ? position.bottom_left : position.bottom_right
string posStats  = statsTablePos
string posImpact = f_free(impactTablePos, posStats, "")
string posExits  = f_free(exitsTablePos, posStats, posImpact)
string tblSize   = tableTextSize == "small" ? size.small : tableTextSize == "normal" ? size.normal : size.tiny

string lblSize = labelSize == "tiny" ? size.tiny : labelSize == "normal" ? size.normal : labelSize == "large" ? size.large : size.small

// ───────────────────────── Types ─────────────────────────
type Seq
    int    id
    int    dir              // 1 = bull, -1 = bear
    int    state = 0        // 0 await3, 1 await4, 2 await5, 3 tap5 trailing, 4 armed, 5 in trade, 6 done
    int    b1
    int    b2
    int    b3
    int    b4
    int    b5
    int    b6
    float  p1
    float  p2
    float  p3
    float  p4
    float  p5
    float  mid
    float  entryP
    float  stopP
    float  tgtP
    int    brk3             // bar that broke tap 1
    int    brk5             // bar that broke tap 3
    int    armedBar         // bar where tap 5 locked
    int    spawnBar         // bar the sequence was created
    string result = ""      // "", "target", "stop" or a cancel reason
    bool   faded = false
    float  mfe = 0.0        // max favorable excursion after the fill, in price
    bool   hidden = false   // shadow-kept: runs for stats, never drawn or alerted
    array<bool> tags        // shadow tags by filter index (F_*): would have been cancelled by it
    int    tagBar           // bar of the first shadow tag
    float  zoneATR          // zone height in ATR at spawn
    int    sess             // fill session: 0 NY, 1 London, 2 Asia
    float  rr               // planned R:R at arming
    bool   optRR = false    // planned R:R outside minRR..maxRR
    bool   opt = false      // optional: R:R flag or daily limit reached
    string optTag = ""      // "rr" or "limit"
    float  mae = 0.0        // max adverse excursion after the fill, in price
    bool   ex2 = false      // skipped under the 2-losses-a-day test
    bool   ex3 = false      // skipped under the 3-losses-a-day test
    float  risk0            // |entry - stop| at the fill
    array<float> xs         // exit variants A–G: stop, target, result R (na = open), size left, banked R
    array<float> xt
    array<float> xr
    array<float> xrem
    array<float> xbank
    int    xopen = 0        // exit variants still open
    label  l1
    label  l2
    label  l3
    label  l4
    label  l5
    label  l6
    label  lDot
    label  lDbg
    line   h1
    line   h2
    line   h3
    line   h4
    line   h5
    line   v3
    line   v5
    box    zone
    line   midLn
    line   eLn
    line   sLn
    line   tLn
    label  eLb
    label  sLb
    label  tLb

// ───────────────────────── Structure & bias ─────────────────────────
// Bias from external structure: close above last swing high -> bull, below last swing low -> bear.
f_bias(int len) =>
    var float lastH = na
    var float lastL = na
    var int   b     = 0
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    if not na(ph)
        lastH := ph
    if not na(pl)
        lastL := pl
    if not na(lastH) and close > lastH
        b := 1
    else if not na(lastL) and close < lastL
        b := -1
    b

float ePH = ta.pivothigh(high, extLen, extLen)
float ePL = ta.pivotlow(low, extLen, extLen)
float iPH = ta.pivothigh(high, intLen, intLen)
float iPL = ta.pivotlow(low, intLen, intLen)
int   ePB = bar_index - extLen
int   iPB = bar_index - intLen
float atr = ta.atr(14)

int autoBias = nz(request.security(syminfo.tickerid, biasTF, f_bias(biasLen), lookahead = barmerge.lookahead_off))
int bias     = biasMode == "Auto" ? autoBias : biasMode == "Bullish" ? 1 : -1

// ───────────────────────── State ─────────────────────────
var array<Seq> active = array.new<Seq>()   // states 0–4
var array<Seq> trades = array.new<Seq>()   // state 5
var array<Seq> hist   = array.new<Seq>()   // finished or cancelled, faded
var array<Seq> shadow = array.new<Seq>()   // hidden (shadow-kept) states 0–4

// One entry per resolved trade, visible or shadow: R, shadow tags and buckets.
var array<float> trR    = array.new<float>()
var array<int>   trMask = array.new<int>()   // shadow tags as a bit mask (bit NF = rr flag)
var array<int>   trRRb  = array.new<int>()   // planned R:R: 0 <1.5, 1 1.5–2, 2 2–3, 3 3–5, 4 >5
var array<int>   trSess = array.new<int>()
var array<int>   trExt  = array.new<int>()   // tap 5 extension from mid: 0 <1, 1 1–2, 2 2–3, 3 >3 zone heights
var array<int>   trZh   = array.new<int>()   // zone height in ATR, same buckets
var array<int>   trA2F  = array.new<int>()   // bars arm -> fill: 0 ≤10, 1 11–40, 2 >40

// Chart (visible) trades only.
var array<float> visR    = array.new<float>()   // R per trade
var array<float> stopMFE = array.new<float>()   // stopped trades: MFE in R
var array<float> winMAE  = array.new<float>()   // winners: MAE in R
var array<Seq>   exitTrk = array.new<Seq>()     // filled trades with exit variants still open
var array<int>   day     = array.new_int(4, 0)  // [trading day, losses today, losses under 2-limit test, under 3-limit test]

var map<string, int> cnt = map.new<string, int>()   // debug counters
var array<float> acc   = array.new_float(2, 0.0)   // [unused, sum of bars arm -> fill]
var map<string, float> fs = map.new<string, float>()   // trade magnitude stats (R, points, $)
var array<bool>  dirty = array.from(false)          // labels changed -> redo stacking

// Per-bar alert flags: 0 armed short, 1 armed long, 2 filled short, 3 filled long, 4 cancelled, 5 target, 6 stop
array<bool> fl = array.new_bool(7, false)

var float lastHiP = na
var int   lastHiB = na
var float lastLoP = na
var int   lastLoB = na
var int   lastSpawnBear = na   // tap-1 bar of the last bearish spawn (one sequence per leg)
var int   lastSpawnBull = na

// ───────────────────────── Helpers ─────────────────────────
seqColor(int d) => d == 1 ? bullColor : bearColor

f_col(Seq s) => s.faded ? color.new(seqColor(s.dir), FADE_TR) : seqColor(s.dir)

f_inc(string k) =>
    cnt.put(k, nz(cnt.get(k)) + 1)
    k

// Break of a level in the sequence direction (down for bear, up for bull).
f_brk(int d, float lvl, string mode) =>
    mode == "Close" ? (d == -1 ? close < lvl : close > lvl) : (d == -1 ? low < lvl : high > lvl)

// Bar extreme in the sequence direction (taps 3/5 track it).
f_trendExt(int d) => d == -1 ? low : high

// a lies further in the sequence direction than b.
f_beyond(int d, float a, float b) => d == -1 ? a < b : a > b

// Price reaches a level from the far side (the 50% line, the entry).
f_reach(int d, float lvl) => d == -1 ? high >= lvl : low <= lvl

// Tap label: lows below the bar, highs above.
f_label(int b, string txt, int d, bool trendSide) =>
    dirty.set(0, true)
    label.new(b, d == -1 ? low : high, txt, xloc = xloc.bar_index, yloc = (d == -1) == trendSide ? yloc.belowbar : yloc.abovebar, color = color.new(seqColor(d), 100), style = label.style_none, textcolor = seqColor(d), size = lblSize)

f_hline(int b, float p, int d) =>
    line.new(b, p, b + BRACKET, p, xloc = xloc.bar_index, color = seqColor(d), style = line.style_solid, width = 1)

f_num(float x) => na(x) ? "null" : str.tostring(math.round_to_mintick(x))

f_entry(Seq s) => entryLevel == "50%" ? s.mid : s.p4 - s.dir * syminfo.mintick

f_levels(Seq s) =>
    float e  = f_entry(s)
    float st = s.p2 - s.dir * stopBufferATR * nz(atr)
    float r  = math.abs(st - e)
    float t  = targetMode == "Tap 5" ? s.p5 : targetMode == "Tap 5 + ext" ? s.p5 + s.dir * targetExtTicks * syminfo.mintick : e + s.dir * fixedR * r
    s.entryP := e
    s.stopP  := st
    s.tgtP   := t
    s

// Target only (entry and stop stay fixed once armed).
f_target(Seq s) =>
    s.tgtP := targetMode == "Tap 5" ? s.p5 : targetMode == "Tap 5 + ext" ? s.p5 + s.dir * targetExtTicks * syminfo.mintick : s.tgtP
    s

// Tap 5 follows a new extreme; returns true if it moved.
f_trail5(Seq s) =>
    float ex = f_trendExt(s.dir)
    bool  mv = f_beyond(s.dir, ex, s.p5)
    if mv
        s.p5 := ex
        s.b5 := bar_index
        label.set_x(s.l5, s.b5)
        line.set_xy1(s.h5, s.b5, s.p5)
        line.set_xy2(s.h5, s.b5 + BRACKET, s.p5)
        line.set_y2(s.v5, s.p5)
        dirty.set(0, true)
    mv

// Tap 5 ran more than maxTap5Ext zone heights beyond mid.
f_runaway(Seq s) => math.abs(s.mid - s.p5) > maxTap5Ext * math.abs(s.p2 - s.p1)

f_alert(string ev, Seq s, string reason) =>
    string msg = '{"event":"' + ev + '","dir":"' + (s.dir == 1 ? "long" : "short") + '","entry":' + f_num(s.entryP) + ',"stop":' + f_num(s.stopP) + ',"target":' + f_num(s.tgtP) + (reason != "" ? ',"reason":"' + reason + '"' : "") + (ev == "armed" ? ',"rr":' + (na(s.rr) ? "null" : str.tostring(s.rr, "0.00")) + ',"optional":' + (s.opt ? "true" : "false") : "") + ',"symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period + '"}'
    if not s.hidden
        alert(msg, alert.freq_once_per_bar_close)
    s

// Recalculate mid and move the zone drawings after tap 2 changes.
f_setZone(Seq s) =>
    s.mid := (s.p1 + s.p2) / 2
    box.set_top(s.zone, math.max(s.p1, s.p2))
    box.set_bottom(s.zone, math.min(s.p1, s.p2))
    line.set_y1(s.midLn, s.mid)
    line.set_y2(s.midLn, s.mid)
    label.set_x(s.l2, s.b2)
    line.set_xy1(s.h2, s.b2, s.p2)
    line.set_xy2(s.h2, s.b2 + BRACKET, s.p2)
    dirty.set(0, true)
    s

f_tradeLine(line ln, label lb, int x1, int x2, float p, string txt, string sfx, color c, string sty) =>
    line  l   = ln
    label lb2 = lb
    string t  = txt + " " + str.tostring(p, format.mintick) + sfx
    if na(l)
        l   := line.new(x1, p, x2, p, xloc = xloc.bar_index, color = c, style = sty, width = 1)
        lb2 := label.new(x2, p, t, xloc = xloc.bar_index, color = color.new(c, 100), style = label.style_label_left, textcolor = c, size = size.tiny)
    else
        line.set_xy1(l, x1, p)
        line.set_xy2(l, x2, p)
        line.set_color(l, c)
        line.set_style(l, sty)
        label.set_xy(lb2, x2, p)
        label.set_text(lb2, t)
        label.set_textcolor(lb2, c)
    [l, lb2]

// Optional setups (R:R out of range or daily limit) get faded, dashed lines.
f_drawTrade(Seq s, int x2) =>
    if showTradeLevels and not s.hidden
        color  c   = s.opt ? color.new(seqColor(s.dir), FADE_TR) : seqColor(s.dir)
        string rrT = na(s.rr) ? "" : str.tostring(s.rr, "0.0") + "R"
        string sfx = s.opt ? " (opt " + (s.optTag == "limit" ? "limit" : rrT) + ")" : (rrT == "" ? "" : " · " + rrT)
        [el, eb] = f_tradeLine(s.eLn, s.eLb, s.armedBar, x2, s.entryP, s.dir == 1 ? "Long" : "Short", sfx, c, s.opt ? line.style_dashed : line.style_solid)
        [sl, sb] = f_tradeLine(s.sLn, s.sLb, s.armedBar, x2, s.stopP, "Stop", "", c, s.opt ? line.style_dashed : line.style_dotted)
        [tl, tb] = f_tradeLine(s.tLn, s.tLb, s.armedBar, x2, s.tgtP, "Target", "", c, line.style_dashed)
        s.eLn := el
        s.eLb := eb
        s.sLn := sl
        s.sLb := sb
        s.tLn := tl
        s.tLb := tb
    s

f_delTrade(Seq s) =>
    line.delete(s.eLn)
    line.delete(s.sLn)
    line.delete(s.tLn)
    label.delete(s.eLb)
    label.delete(s.sLb)
    label.delete(s.tLb)
    s.eLn := na
    s.sLn := na
    s.tLn := na
    s.eLb := na
    s.sLb := na
    s.tLb := na
    s

method delAll(Seq s) =>
    label.delete(s.l1)
    label.delete(s.l2)
    label.delete(s.l3)
    label.delete(s.l4)
    label.delete(s.l5)
    label.delete(s.l6)
    label.delete(s.lDot)
    label.delete(s.lDbg)
    line.delete(s.h1)
    line.delete(s.h2)
    line.delete(s.h3)
    line.delete(s.h4)
    line.delete(s.h5)
    line.delete(s.v3)
    line.delete(s.v5)
    box.delete(s.zone)
    line.delete(s.midLn)
    f_delTrade(s)
    dirty.set(0, true)
    s

f_fade(Seq s) =>
    s.faded := true
    color c  = f_col(s)
    color cz = color.new(seqColor(s.dir), FADE_ZT)
    label.set_textcolor(s.l1, c)
    label.set_textcolor(s.l2, c)
    label.set_textcolor(s.l3, c)
    label.set_textcolor(s.l4, c)
    label.set_textcolor(s.l5, c)
    label.set_textcolor(s.l6, c)
    label.set_color(s.lDot, c)
    line.set_color(s.h1, c)
    line.set_color(s.h2, c)
    line.set_color(s.h3, c)
    line.set_color(s.h4, c)
    line.set_color(s.h5, c)
    line.set_color(s.v3, c)
    line.set_color(s.v5, c)
    line.set_color(s.midLn, c)
    box.set_bgcolor(s.zone, cz)
    box.set_border_color(s.zone, cz)
    dirty.set(0, true)
    s

// Latest tap reached (for the debug reason label).
f_lastTap(Seq s) =>
    int   b = s.b2
    float p = s.p2
    if not na(s.b5)
        b := s.b5
        p := s.p5
    else if not na(s.b4)
        b := s.b4
        p := s.p4
    else if not na(s.b3)
        b := s.b3
        p := s.p3
    [b, p]

// Cancel before fill: pull trade lines, freeze, fade (or delete), log the reason.
// A hidden (shadow) sequence just stops; it has no drawings or alerts.
f_cancel(Seq s, string reason) =>
    if s.hidden
        s.state  := 6
        s.result := reason
    else
        bool wasArmed = s.state == 4
        bool keep     = keepCancelled and (s.state > 0 or debugMode)
        f_inc("cancelled")
        f_inc(reason)
        if wasArmed
            f_alert("cancelled", s, reason)
            fl.set(4, true)
        s.state  := 6
        s.result := reason
        f_delTrade(s)
        box.set_right(s.zone, bar_index)
        line.set_x2(s.midLn, bar_index)
        if keep
            f_fade(s)
            if debugMode
                [lb, lp] = f_lastTap(s)
                s.lDbg := label.new(lb, lp, reason, xloc = xloc.bar_index, color = color.new(color.gray, 100), style = label.style_label_left, textcolor = color.gray, size = size.tiny)
            hist.push(s)
        else
            s.delAll()
    s

f_nullDraw(Seq s) =>
    s.l1    := na
    s.l2    := na
    s.l3    := na
    s.l4    := na
    s.l5    := na
    s.l6    := na
    s.lDot  := na
    s.lDbg  := na
    s.h1    := na
    s.h2    := na
    s.h3    := na
    s.h4    := na
    s.h5    := na
    s.v3    := na
    s.v5    := na
    s.zone  := na
    s.midLn := na
    s.eLn   := na
    s.sLn   := na
    s.tLn   := na
    s.eLb   := na
    s.sLb   := na
    s.tLb   := na
    s

// Shadow tag on a visible sequence: the chart shows the Enforce view (a faded,
// cancelled copy keeps the drawings) while the sequence itself runs on hidden.
f_hide(Seq s, string reason) =>
    Seq v = s.copy()
    v.state  := 6
    v.result := reason
    f_inc("cancelled")
    f_inc(reason)
    if s.state == 4
        f_alert("cancelled", s, reason)
        fl.set(4, true)
    f_delTrade(v)
    box.set_right(v.zone, bar_index)
    line.set_x2(v.midLn, bar_index)
    if keepCancelled
        f_fade(v)
        if debugMode
            [lb, lp] = f_lastTap(v)
            v.lDbg := label.new(lb, lp, reason + " (shadow)", xloc = xloc.bar_index, color = color.new(color.gray, 100), style = label.style_label_left, textcolor = color.gray, size = size.tiny)
        hist.push(v)
    else
        v.delAll()
    s.hidden := true
    f_nullDraw(s)
    s

// Invented filter fi. Enforce cancels; Shadow tags once (and hides a visible
// sequence) but lets it run; Off does nothing. Returns true when cancelled.
f_filter(Seq s, int fi) =>
    string mode   = FMODES.get(fi)
    string filt   = FNAMES.get(fi)
    bool   killed = false
    if mode == "Enforce"
        f_cancel(s, filt)
        killed := true
    else if mode == "Shadow" and not s.tags.get(fi)
        s.tags.set(fi, true)
        if na(s.tagBar)
            s.tagBar := bar_index
        f_inc("tag." + filt)
        if not s.hidden
            f_hide(s, filt)
    killed

f_addf(string k, float v) =>
    fs.put(k, nz(fs.get(k)) + v)
    k

f_bucket4(float x) => na(x) ? -1 : x < 1 ? 0 : x < 2 ? 1 : x < 3 ? 2 : 3

f_rrBucket(float x) => na(x) ? -1 : x < 1.5 ? 0 : x < 2 ? 1 : x < 3 ? 2 : x < 5 ? 3 : 4

// Bit i of a tag mask (no bitwise operators in Pine).
f_has(int mask, int i) => int(math.floor(mask / math.pow(2, i))) % 2 == 1

// Running R curve for a stats prefix: count, sum, peak-to-trough drawdown.
f_curve(string p, float r) =>
    f_addf(p + ".n", 1)
    f_addf(p + ".sum", r)
    float cum = nz(fs.get(p + ".cum")) + r
    fs.put(p + ".cum", cum)
    fs.put(p + ".peak", math.max(nz(fs.get(p + ".peak")), cum))
    fs.put(p + ".dd", math.max(nz(fs.get(p + ".dd")), fs.get(p + ".peak") - cum))
    p

// One exit variant resolved.
f_xdone(Seq s, int v, float r) =>
    s.xr.set(v, r)
    s.xopen := s.xopen - 1
    string p = "x" + str.tostring(v)
    f_curve(p, r)
    if r > 0
        f_addf(p + ".nW", 1)
        f_addf(p + ".w", r)
    else if r < 0
        f_addf(p + ".l", -r)
    f_addf(p + ".usd", (r * s.risk0 * syminfo.pointvalue - 2 * commissionPerSide) * contracts)
    s

// Exit variants on one bar after the fill. Stop is checked first (same bar = stop);
// stop moves and the partial take effect from the next bar.
//   A tap 5   B 1.5R   C 2R   D 3R   E tap 5, BE at 1R   F tap 5, BE at 1.5R   G half at 1R, BE, rest to tap 5
f_xstep(Seq s) =>
    float fav = (s.dir == -1 ? s.entryP - low : high - s.entryP) / s.risk0
    for v = 0 to NV - 1
        if na(s.xr.get(v))
            float st = s.xs.get(v)
            float tg = s.xt.get(v)
            bool  hs = s.dir == -1 ? high >= st : low <= st
            bool  ht = s.dir == -1 ? low <= tg : high >= tg
            if hs
                f_xdone(s, v, s.xbank.get(v) + s.xrem.get(v) * s.dir * (st - s.entryP) / s.risk0)
            else if ht
                f_xdone(s, v, s.xbank.get(v) + s.xrem.get(v) * s.dir * (tg - s.entryP) / s.risk0)
            else if (v == 4 and fav >= 1.0) or (v == 5 and fav >= 1.5)
                s.xs.set(v, s.entryP)
            else if v == 6 and s.xrem.get(v) == 1.0 and fav >= 1.0
                s.xbank.set(v, 0.5)
                s.xrem.set(v, 0.5)
                s.xs.set(v, s.entryP)
    s

// Trade result after a fill. Visible trades feed the chart stats; every trade
// (visible or shadow) is recorded for the filter impact table.
f_finish(Seq s, string res) =>
    bool  win  = res == "target"
    float risk = math.abs(s.entryP - s.stopP)
    float pts  = s.dir * ((win ? s.tgtP : s.stopP) - s.entryP)   // per contract
    float r    = risk > 0 ? pts / risk : 0.0
    float zh   = math.abs(s.p2 - s.p1)
    s.state  := 6
    s.result := res
    int mask = s.optRR ? int(math.pow(2, NF)) : 0
    for fi = 0 to NF - 1
        if s.tags.get(fi)
            mask += int(math.pow(2, fi))
    trR.push(r)
    trMask.push(mask)
    trRRb.push(f_rrBucket(s.rr))
    trSess.push(s.sess)
    trExt.push(f_bucket4(zh > 0 ? math.abs(s.p5 - s.mid) / zh : na))
    trZh.push(f_bucket4(s.zoneATR))
    int a2f = s.b6 - s.armedBar
    trA2F.push(a2f <= 10 ? 0 : a2f <= 40 ? 1 : 2)
    if not s.hidden
        f_inc(res)
        visR.push(r)
        if win
            winMAE.push(risk > 0 ? s.mae / risk : 0.0)
        else
            stopMFE.push(risk > 0 ? s.mfe / risk : 0.0)
        // Magnitude stats: totals and per direction (".L" / ".S").
        for sfx in array.from("", s.dir == 1 ? ".L" : ".S")
            f_addf("n" + sfx, 1)
            f_addf((win ? "nW" : "nL") + sfx, 1)
            f_addf((win ? "winR" : "lossR") + sfx, math.abs(r))
        f_addf("pts", pts * contracts)
        f_addf("usd", (pts * syminfo.pointvalue - 2 * commissionPerSide) * contracts)
        float cum = nz(fs.get("cum")) + r
        fs.put("cum", cum)
        fs.put("peak", math.max(nz(fs.get("peak")), cum))
        fs.put("dd", math.max(nz(fs.get("dd")), fs.get("peak") - cum))
        fs.put("streak", win ? 0.0 : nz(fs.get("streak")) + 1)
        fs.put("maxStreak", math.max(nz(fs.get("maxStreak")), fs.get("streak")))
        if win
            fs.put("bigWin", math.max(nz(fs.get("bigWin")), r))
        else
            f_addf("mfeStop", risk > 0 ? s.mfe / risk : 0.0)
        // Daily loss limit: only non-optional trades count (optional ones would be skipped).
        if not s.opt
            f_curve("dn", r)
            if not s.ex2
                f_curve("d2", r)
            if not s.ex3
                f_curve("d3", r)
            if not win
                day.set(1, day.get(1) + 1)
                if not s.ex2
                    day.set(2, day.get(2) + 1)
                if not s.ex3
                    day.set(3, day.get(3) + 1)
        f_alert(res, s, "")
        fl.set(res == "target" ? 5 : 6, true)
        f_delTrade(s)
        f_fade(s)
        hist.push(s)
    s

// Tap 5 locked: final levels, planned R:R and the optional flag.
// A hidden sequence never supersedes a visible one (it does not exist in the Enforce view).
f_arm(Seq s) =>
    bool  killed = false
    float zh     = math.abs(s.p2 - s.p1)
    if extMinMode != "Off" and zh > 0 and math.abs(s.p5 - s.mid) / zh < minTap5Ext
        killed := f_filter(s, F_EXTMIN)
    if not killed
        s.state    := 4
        s.armedBar := bar_index
        f_levels(s)
        float risk = math.abs(s.entryP - s.stopP)
        bool  lim  = dailyMode == "Enforce" and day.get(1) >= dailyMaxLosses
        s.rr     := risk > 0 ? math.abs(s.tgtP - s.entryP) / risk : na
        s.optRR  := not na(s.rr) and (s.rr < minRR or (maxRR > 0 and s.rr > maxRR))
        s.opt    := s.optRR or lim
        s.optTag := lim ? "limit" : s.optRR ? "rr" : ""
        if s.optRR
            f_inc("tag.rr")
        if supMode != "Off"
            for o in active
                if o.id != s.id and o.dir == s.dir and o.state == 4 and (not s.hidden or o.hidden)
                    f_filter(o, F_SUP)
            for o in shadow
                if o.id != s.id and o.dir == s.dir and o.state == 4
                    f_filter(o, F_SUP)
        if not s.hidden
            f_inc("armed")
            f_alert("armed", s, "")
            fl.set(s.dir == 1 ? 1 : 0, true)
    s

// Session of the current bar in New York time: 0 NY 09:30–16:00, 1 London 03:00–09:30, 2 Asia.
f_session() =>
    int m = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
    m >= 570 and m < 960 ? 0 : m >= 180 and m < 570 ? 1 : 2

// Tap 6: sweep of tap 4 into the entry level.
f_fill(Seq s) =>
    color c    = seqColor(s.dir)
    float risk = math.abs(s.entryP - s.stopP)
    s.state := 5
    s.b6    := bar_index
    s.sess  := f_session()
    s.risk0 := risk
    if not s.hidden
        s.l6   := label.new(bar_index, s.entryP, "6", xloc = xloc.bar_index, color = color.new(c, 100), style = s.dir == -1 ? label.style_label_down : label.style_label_up, textcolor = c, size = lblSize)
        s.lDot := label.new(bar_index, s.entryP, "", xloc = xloc.bar_index, color = c, style = label.style_circle, size = size.tiny)
        box.set_right(s.zone, bar_index)
        line.set_x2(s.midLn, bar_index)
        line.set_x2(s.h4, math.min(s.b4 + BRACKET, bar_index))
        f_drawTrade(s, bar_index + BRACKET)
        f_inc("filled")
        acc.set(1, acc.get(1) + (bar_index - s.armedBar))
        f_alert("filled", s, "")
        fl.set(s.dir == 1 ? 3 : 2, true)
        // Daily-limit test: skipped if the day's limit was already reached (optional trades are always skipped).
        s.ex2 := s.opt or day.get(2) >= 2
        s.ex3 := s.opt or day.get(3) >= 3
        // Exit variants A–G, resolved in parallel from the same bars.
        if risk > 0
            float e = s.entryP
            int   d = s.dir
            s.xs    := array.new_float(NV, s.stopP)
            s.xt    := array.from(s.tgtP, e + d * 1.5 * risk, e + d * 2.0 * risk, e + d * 3.0 * risk, s.tgtP, s.tgtP, s.tgtP)
            s.xr    := array.new_float(NV, na)
            s.xrem  := array.new_float(NV, 1.0)
            s.xbank := array.new_float(NV, 0.0)
            s.xopen := NV
    trades.push(s)
    // Stop touched on the fill bar itself (order unknown -> assume stop).
    if s.dir == -1 ? high >= s.stopP : low <= s.stopP
        f_finish(s, "stop")
        if s.xopen > 0
            for v = 0 to NV - 1
                f_xdone(s, v, -1.0)
    else if s.xopen > 0
        exitTrk.push(s)
    s

// Spawn a sequence from a confirmed leg. Bars between tap 2 and now (the pivot
// confirmation window) are replayed so a tap-1 break inside it is not missed.
// A zone outside minZoneATR..maxZoneATR is skipped (Enforce), or spawned hidden and tagged (Shadow).
f_spawn(int d, int b1, float p1, int b2, float p2) =>
    float top   = math.max(p1, p2)
    float bot   = math.min(p1, p2)
    float hgt   = top - bot
    bool  small = zoneMode != "Off" and minZoneATR > 0 and (na(atr) or hgt < minZoneATR * atr)
    bool  big   = maxZoneMode != "Off" and not na(atr) and hgt > maxZoneATR * atr
    bool  ghost = (small and zoneMode == "Shadow") or (big and maxZoneMode == "Shadow")
    bool  ok    = hgt > 0 and not (small and zoneMode == "Enforce") and not (big and maxZoneMode == "Enforce")
    Seq s = Seq.new(dir = d, b1 = b1, p1 = p1, b2 = b2, p2 = p2, mid = (p1 + p2) / 2, hidden = ghost, tags = array.new_bool(NF, false), zoneATR = na(atr) or atr == 0 ? na : hgt / atr)
    if ok
        for k = 1 to extLen - 1
            int   i  = extLen - k
            float cl = close[i]
            float lo = low[i]
            float hi = high[i]
            float ex = d == -1 ? lo : hi
            if s.state == 0
                bool brk = breakMode3 == "Close" ? (d == -1 ? cl < p1 : cl > p1) : (d == -1 ? lo < p1 : hi > p1)
                if brk
                    s.state := 1
                    s.brk3  := bar_index - i
                    s.b3    := bar_index - i
                    s.p3    := ex
            else
                bool mit = mitMode == "Close" ? (d == -1 ? cl > s.mid : cl < s.mid) : (d == -1 ? hi >= s.mid : lo <= s.mid)
                if mitMode != "Off" and mit
                    ok := false
                if d == -1 ? lo < s.p3 : hi > s.p3
                    s.p3 := ex
                    s.b3 := bar_index - i
    // Dedupe against same-direction zones in the same pool (visible or shadow).
    array<Seq> pool = ghost ? shadow : active
    array<int> repl = array.new<int>()
    if ok and pool.size() > 0
        for j = 0 to pool.size() - 1
            Seq o = pool.get(j)
            if o.dir == d
                float ot = math.max(o.p1, o.p2)
                float ob = math.min(o.p1, o.p2)
                float ov = math.min(top, ot) - math.max(bot, ob)
                float sm = math.min(hgt, ot - ob)
                if sm > 0 and ov > dedupeOverlap / 100.0 * sm
                    if hgt > ot - ob and o.state == 0
                        repl.push(j)
                    else
                        ok := false
    if ok
        if repl.size() > 0
            for j = repl.size() - 1 to 0
                Seq o = pool.remove(repl.get(j))
                o.delAll()
        // Cap (visible pool): evict the least-advanced candidate, oldest among ties.
        if not ghost and active.size() >= maxActive
            int ix = 0
            for j = 0 to active.size() - 1
                if active.get(j).state < active.get(ix).state
                    ix := j
            Seq ev = active.remove(ix)
            f_cancel(ev, "evict")
        s.id       := nz(cnt.get("_id")) + 1
        s.spawnBar := bar_index
        f_inc("_id")
        if ghost
            s.tagBar := bar_index
            if small and zoneMode == "Shadow"
                s.tags.set(F_MINZ, true)
                f_inc("tag.minZoneATR")
            if big and maxZoneMode == "Shadow"
                s.tags.set(F_MAXZ, true)
                f_inc("tag.maxZoneATR")
        else
            color c = seqColor(d)
            f_inc("spawned")
            s.l1    := f_label(b1, "1", d, true)
            s.l2    := f_label(b2, "2", d, false)
            s.h1    := f_hline(b1, p1, d)
            s.h2    := f_hline(b2, p2, d)
            s.zone  := box.new(b1, top, bar_index, bot, xloc = xloc.bar_index, border_color = color.new(c, ZONE_TR), border_width = 1, bgcolor = color.new(c, ZONE_TR))
            s.midLn := line.new(b1, s.mid, bar_index, s.mid, xloc = xloc.bar_index, color = color.new(c, MID_TR), style = line.style_dashed, width = 1)
            if s.state == 1
                line.set_x2(s.h1, math.min(b1 + BRACKET, s.brk3))
                s.l3 := f_label(s.b3, "3", d, true)
                s.h3 := f_hline(s.b3, s.p3, d)
                s.v3 := line.new(s.brk3, p1, s.brk3, s.p3, xloc = xloc.bar_index, color = c, width = 1)
        pool.push(s)
    s

// Stacking: gather the tap 1–5 labels of one sequence.
f_collect(Seq s, array<label> L, array<int> B, array<float> P, array<bool> D, array<int> I, array<string> T, array<color> C) =>
    for k = 1 to 5
        label lb = k == 1 ? s.l1 : k == 2 ? s.l2 : k == 3 ? s.l3 : k == 4 ? s.l4 : s.l5
        if not na(lb)
            L.push(lb)
            B.push(k == 1 ? s.b1 : k == 2 ? s.b2 : k == 3 ? s.b3 : k == 4 ? s.b4 : s.b5)
            P.push(k == 1 ? s.p1 : k == 2 ? s.p2 : k == 3 ? s.p3 : k == 4 ? s.p4 : s.p5)
            D.push((k % 2 == 1) == (s.dir == -1))
            I.push(s.id)
            T.push(str.tostring(k))
            C.push(f_col(s))
    s

// Tap 2 may still move out while waiting for tap 3 (zone expands).
f_tap2(Seq s) =>
    if s.state == 0
        if s.dir == -1 and not na(ePH) and ePH > s.p2 and ePB > s.b2
            s.p2 := ePH
            s.b2 := ePB
            f_setZone(s)
        else if s.dir == 1 and not na(ePL) and ePL < s.p2 and ePB > s.b2
            s.p2 := ePL
            s.b2 := ePB
            f_setZone(s)
    s

// Rank of an armed visible order among same-direction armed orders, oldest first.
f_armRank(Seq s) =>
    int rk = 0
    for o in active
        if o.id != s.id and o.dir == s.dir and o.state == 4 and not o.hidden and (o.armedBar < s.armedBar or (o.armedBar == s.armedBar and o.id < s.id))
            rk += 1
    rk

// Trading day id; the CME day starts 18:00 ET, so shift by 6 h before taking the date.
f_tday() =>
    int t = time + 6 * 3600000
    year(t, "America/New_York") * 10000 + month(t, "America/New_York") * 100 + dayofmonth(t, "America/New_York")

// ───────────────────────── Engine (confirmed bars only) ─────────────────────────
if barstate.isconfirmed
    int tday = f_tday()
    if tday != day.get(0)
        day.set(0, tday)
        day.set(1, 0)
        day.set(2, 0)
        day.set(3, 0)

    if not na(ePH) or not na(ePL)
        for s in active
            f_tap2(s)
        for s in shadow
            f_tap2(s)

    // Spawn: bearish leg = ext low (tap 1) -> ext high (tap 2); bullish is the mirror.
    if not na(ePH) and bias == -1 and not na(lastLoP) and lastLoB < ePB and ePH > lastLoP and lastLoB != nz(lastSpawnBear, -1)
        f_spawn(-1, lastLoB, lastLoP, ePB, ePH)
        lastSpawnBear := lastLoB
    if not na(ePL) and bias == 1 and not na(lastHiP) and lastHiB < ePB and ePL < lastHiP and lastHiB != nz(lastSpawnBull, -1)
        f_spawn(1, lastHiB, lastHiP, ePB, ePL)
        lastSpawnBull := lastHiB
    if not na(ePH)
        lastHiP := ePH
        lastHiB := ePB
    if not na(ePL)
        lastLoP := ePL
        lastLoB := ePB

    // Step visible and shadow candidates (at most one state advance per bar).
    // Sequences hidden during this bar are already in the list and are not stepped twice.
    array<Seq> work = array.concat(active.copy(), shadow.copy())
    for s in work
        if s.state <= 4
            int   d    = s.dir
            color c    = seqColor(d)
            float piv  = d == -1 ? iPH : iPL
            bool  ok4  = not na(piv) and (d == -1 ? piv < s.mid : piv > s.mid) and (not require4InZone or (d == -1 ? piv > s.p1 : piv < s.p1))
            bool  dead = false
            if s.state == 4 and expMode != "Off" and bar_index - s.armedBar > expiryBars
                dead := f_filter(s, F_EXP)

            if not dead
                if biasCancel and biasMode == "Auto" and bias != d and bar_index > s.spawnBar
                    f_cancel(s, "bias")
                else if s.state == 4 and bar_index > s.armedBar and f_reach(d, s.entryP)
                    // Session filter acts on the would-be fill bar.
                    bool skip = false
                    if sessMode != "Off" and f_session() == 0
                        skip := f_filter(s, F_SESS)
                    if not skip
                        f_fill(s)
                else if d == -1 ? close > s.p2 : close < s.p2
                    f_cancel(s, "close>2")
                else if (s.state == 1 or s.state == 2) and mitMode != "Off" and bar_index > s.brk3 and (mitMode == "Close" ? (d == -1 ? close > s.mid : close < s.mid) : f_reach(d, s.mid))
                    f_cancel(s, "mid")
                else if s.state == 0
                    // Tap 3: big BOS / sweep of tap 1.
                    if f_brk(d, s.p1, breakMode3)
                        s.state := 1
                        s.brk3  := bar_index
                        s.b3    := bar_index
                        s.p3    := f_trendExt(d)
                        if not s.hidden
                            line.set_x2(s.h1, math.min(s.b1 + BRACKET, bar_index))
                            s.l3 := f_label(s.b3, "3", d, true)
                            s.h3 := f_hline(s.b3, s.p3, d)
                            s.v3 := line.new(bar_index, s.p1, bar_index, s.p3, xloc = xloc.bar_index, color = c, width = 1)
                else if s.state == 1
                    // Tap 3 tracks the extreme until tap 4 forms.
                    float ex = f_trendExt(d)
                    if f_beyond(d, ex, s.p3)
                        s.p3 := ex
                        s.b3 := bar_index
                        label.set_x(s.l3, s.b3)
                        line.set_xy1(s.h3, s.b3, s.p3)
                        line.set_xy2(s.h3, s.b3 + BRACKET, s.p3)
                        line.set_y2(s.v3, s.p3)
                        dirty.set(0, true)
                    // Tap 4: internal pivot after tap 3, on the near side of mid.
                    if ok4 and iPB > s.b3
                        s.state := 2
                        s.p4    := piv
                        s.b4    := iPB
                        if not s.hidden
                            s.l4 := f_label(s.b4, "4", d, false)
                            s.h4 := f_hline(s.b4, s.p4, d)
                else if s.state == 2
                    // A newer qualifying internal pivot replaces tap 4.
                    if ok4 and iPB > s.b4
                        s.p4 := piv
                        s.b4 := iPB
                        label.set_x(s.l4, s.b4)
                        line.set_xy1(s.h4, s.b4, s.p4)
                        line.set_xy2(s.h4, s.b4 + BRACKET, s.p4)
                        dirty.set(0, true)
                    // Tap 5: mini BOS through tap 3 -> starts trailing.
                    if f_brk(d, s.p3, breakMode5)
                        s.state := 3
                        s.brk5  := bar_index
                        s.b5    := bar_index
                        s.p5    := f_trendExt(d)
                        if not s.hidden
                            line.set_x2(s.h3, math.min(s.b3 + BRACKET, bar_index))
                            s.l5 := f_label(s.b5, "5", d, true)
                            s.h5 := f_hline(s.b5, s.p5, d)
                            s.v5 := line.new(bar_index, s.p3, bar_index, s.p5, xloc = xloc.bar_index, color = c, width = 1)
                else if s.state == 3
                    // Tap 5 trails the extreme and locks on an opposite internal pivot after it, or a touch of the entry.
                    f_trail5(s)
                    float opp    = d == -1 ? iPH : iPL
                    bool  killed = false
                    if runMode != "Off" and f_runaway(s)
                        killed := f_filter(s, F_RUN)
                    if not killed and ((not na(opp) and iPB > s.b5) or f_reach(d, f_entry(s)))
                        f_arm(s)
                else if s.state == 4
                    // Price ran past the locked tap 5: re-trail it and move the target; entry and stop stay.
                    if f_trail5(s)
                        bool killed = false
                        if runMode != "Off" and f_runaway(s)
                            killed := f_filter(s, F_RUN)
                        if not killed
                            f_target(s)


            if s.state <= 4 and not s.hidden
                box.set_right(s.zone, bar_index)
                line.set_x2(s.midLn, bar_index)
                if s.state == 4 and bar_index - s.armedBar >= minArmBars
                    if f_armRank(s) < maxArmedPerDir
                        f_drawTrade(s, bar_index + BRACKET)
                    else
                        f_delTrade(s)

    // Trade outcome after a fill. Both on one bar -> stop.
    for s in trades
        if s.state == 5 and bar_index > s.b6
            s.mfe := math.max(s.mfe, s.dir == -1 ? s.entryP - low : high - s.entryP)
            s.mae := math.max(s.mae, s.dir == -1 ? high - s.entryP : s.entryP - low)
            bool hitStop = s.dir == -1 ? high >= s.stopP : low <= s.stopP
            bool hitTgt  = s.dir == -1 ? low <= s.tgtP : high >= s.tgtP
            if hitStop
                f_finish(s, "stop")
            else if hitTgt
                f_finish(s, "target")
            else
                f_drawTrade(s, bar_index + BRACKET)

    // Exit variants keep resolving after the chart trade (variant A) is done.
    for s in exitTrk
        if bar_index > s.b6 and s.xopen > 0
            f_xstep(s)

    // Drop sequences that left each list; sequences hidden this bar move to the shadow list.
    if active.size() > 0
        for j = active.size() - 1 to 0
            Seq a = active.get(j)
            if a.state > 4
                active.remove(j)
            else if a.hidden
                active.remove(j)
                shadow.push(a)
    if shadow.size() > 0
        for j = shadow.size() - 1 to 0
            if shadow.get(j).state > 4
                shadow.remove(j)
    // Shadow cap: drop the least-advanced, oldest hidden sequence.
    while shadow.size() > SHADOW_CAP * maxActive
        int ix = 0
        for j = 0 to shadow.size() - 1
            if shadow.get(j).state < shadow.get(ix).state
                ix := j
        shadow.remove(ix)
    if trades.size() > 0
        for j = trades.size() - 1 to 0
            if trades.get(j).state != 5
                trades.remove(j)
    if exitTrk.size() > 0
        for j = exitTrk.size() - 1 to 0
            if exitTrk.get(j).xopen <= 0
                exitTrk.remove(j)
    while exitTrk.size() > EXIT_CAP
        exitTrk.shift()
    int nOpen = 0
    for t in trades
        if not t.hidden
            nOpen += 1
    fs.put("maxOpen", math.max(nz(fs.get("maxOpen")), nOpen))
    while hist.size() > keepHistory
        Seq old = hist.shift()
        old.delAll()

    // Stacked labels: same bar, side and price -> one label ("5/3") in the newest sequence's color.
    if dirty.get(0)
        dirty.set(0, false)
        array<label>  L = array.new<label>()
        array<int>    B = array.new<int>()
        array<float>  P = array.new<float>()
        array<bool>   D = array.new<bool>()
        array<int>    I = array.new<int>()
        array<string> T = array.new<string>()
        array<color>  C = array.new<color>()
        for s in active
            f_collect(s, L, B, P, D, I, T, C)
        for s in trades
            f_collect(s, L, B, P, D, I, T, C)
        for s in hist
            f_collect(s, L, B, P, D, I, T, C)
        int n = L.size()
        if n > 0
            for j = 0 to n - 1
                array<int> grp = array.new<int>()
                int newest = j
                for k = 0 to n - 1
                    if B.get(k) == B.get(j) and D.get(k) == D.get(j) and math.abs(P.get(k) - P.get(j)) < syminfo.mintick / 2
                        grp.push(k)
                        if I.get(k) > I.get(newest)
                            newest := k
                string txt = T.get(j)
                color  col = C.get(j)
                if grp.size() > 1
                    if newest != j
                        txt := ""
                    else
                        array<int> ids = array.new<int>()
                        for g in grp
                            ids.push(I.get(g))
                        array<int> ord = ids.sort_indices()
                        txt := ""
                        for o in ord
                            txt := txt + (txt == "" ? "" : "/") + T.get(grp.get(o))
                label.set_text(L.get(j), txt)
                label.set_textcolor(L.get(j), col)

// ───────────────────────── Debug tables ─────────────────────────
var table dbg = na
var table imp = na
var table exT = na

f_pct(float x) => na(x) ? "–" : str.tostring(100 * x, "0.0") + "%"
f_r(float x)   => na(x) ? "–" : (x > 0 ? "+" : "") + str.tostring(x, "0.00") + "R"
f_ratio(float x) => na(x) ? "–" : str.tostring(x, "0.00")

// Trades · win rate · expectancy for one direction suffix ("", ".L", ".S").
f_side(string sfx) =>
    float n  = nz(fs.get("n" + sfx))
    float nW = nz(fs.get("nW" + sfx))
    float ex = n > 0 ? (nz(fs.get("winR" + sfx)) - nz(fs.get("lossR" + sfx))) / n : na
    str.tostring(n, "0") + " · " + f_pct(n > 0 ? nW / n : na) + " · " + f_r(ex)

f_kv(array<string> K, array<string> V, string k, string v) =>
    K.push(k)
    V.push(v)
    k

f_cell(table t, int col, int row, string txt) =>
    table.cell(t, col, row, txt, text_color = color.gray, text_size = tblSize, text_halign = col == 0 ? text.align_left : text.align_right)
    row

// Count, win rate, expectancy, median R and expectancy without the 5 largest wins.
f_robust(array<float> X) =>
    int   n   = X.size()
    float wr  = na
    float ex  = na
    float md  = na
    float ex5 = na
    if n > 0
        float sum = X.sum()
        int   nW  = 0
        for x in X
            if x > 0
                nW += 1
        array<float> Y = X.copy()
        Y.sort(order.descending)
        int   k   = 0
        float top = 0.0
        for y in Y
            if k < 5 and y > 0
                top += y
                k += 1
        wr  := 1.0 * nW / n
        ex  := sum / n
        md  := X.median()
        ex5 := n - k > 0 ? (sum - top) / (n - k) : na
    [n, wr, ex, md, ex5]

f_robHead(table t, int row, string title) =>
    f_cell(t, 0, row, title)
    f_cell(t, 1, row, "n")
    f_cell(t, 2, row, "win")
    f_cell(t, 3, row, "exp")
    f_cell(t, 4, row, "median")
    f_cell(t, 5, row, "ex top 5")
    row + 1

f_robRow(table t, int row, string name, array<float> X) =>
    [n, wr, ex, md, ex5] = f_robust(X)
    f_cell(t, 0, row, name)
    f_cell(t, 1, row, str.tostring(n))
    f_cell(t, 2, row, f_pct(wr))
    f_cell(t, 3, row, f_r(ex))
    f_cell(t, 4, row, f_r(md))
    f_cell(t, 5, row, f_r(ex5))
    row + 1

// ── Stats (chart view) ──
if debugMode and barstate.islast
    if na(dbg)
        dbg := table.new(f_pos(posStats), 2, 50, bgcolor = color.new(color.gray, 90), frame_width = 0, border_width = 0)
    int   nFill = nz(cnt.get("filled"))
    int   nTgt  = nz(cnt.get("target"))
    int   nStop = nz(cnt.get("stop"))
    float nW    = nz(fs.get("nW"))
    float nL    = nz(fs.get("nL"))
    float n     = nW + nL
    float winR  = nz(fs.get("winR"))
    float lossR = nz(fs.get("lossR"))
    float wr    = n > 0 ? nW / n : na
    float avgW  = nW > 0 ? winR / nW : na
    float avgL  = nL > 0 ? -lossR / nL : na
    float payoff = na(avgW) or na(avgL) or avgL == 0 ? na : avgW / math.abs(avgL)
    float pf    = lossR > 0 ? winR / lossR : na
    float expR  = n > 0 ? (winR - lossR) / n : na
    float beWR  = na(payoff) ? na : 1 / (1 + payoff)
    [nV, wrV, exV, mdV, ex5V] = f_robust(visR)

    array<string> K = array.new<string>()
    array<string> V = array.new<string>()
    f_kv(K, V, "Chart view", "shadow = cancelled")
    f_kv(K, V, "Spawned", str.tostring(nz(cnt.get("spawned"))))
    f_kv(K, V, "Armed", str.tostring(nz(cnt.get("armed"))))
    f_kv(K, V, "Filled", str.tostring(nFill))
    f_kv(K, V, "  Open", str.tostring(nFill - nTgt - nStop))
    f_kv(K, V, "Max concurrent open trades", str.tostring(nz(fs.get("maxOpen")), "0"))
    f_kv(K, V, "Cancelled", str.tostring(nz(cnt.get("cancelled"))))
    for rs in array.from("evict", "bias", "mid", "close>2", "runaway", "superseded", "expiry", "minTap5Ext", "session")
        f_kv(K, V, "  " + rs, str.tostring(nz(cnt.get(rs))))
    f_kv(K, V, "Target hits", str.tostring(nTgt))
    f_kv(K, V, "Stop hits", str.tostring(nStop))
    f_kv(K, V, "Win rate (breakeven)", f_pct(wr) + " (" + f_pct(beWR) + ")")
    f_kv(K, V, "Avg win", f_r(avgW))
    f_kv(K, V, "Avg loss", f_r(avgL))
    f_kv(K, V, "Payoff ratio", f_ratio(payoff))
    f_kv(K, V, "Profit factor", na(pf) and winR > 0 ? "∞" : f_ratio(pf))
    f_kv(K, V, "Expectancy", f_r(expR))
    f_kv(K, V, "Median R", f_r(mdV))
    f_kv(K, V, "Expectancy ex top 5 wins", f_r(ex5V))
    f_kv(K, V, "Net points", str.tostring(nz(fs.get("pts")), format.mintick))
    f_kv(K, V, "Net $ (" + str.tostring(contracts) + " ct, after comm.)", str.tostring(nz(fs.get("usd")), "#,##0.00"))
    f_kv(K, V, "Max drawdown", f_r(-nz(fs.get("dd"))))
    f_kv(K, V, "Max consecutive losses", str.tostring(nz(fs.get("maxStreak")), "0"))
    f_kv(K, V, "Largest win", f_r(fs.get("bigWin")))
    f_kv(K, V, "Avg MFE on stops", nL > 0 ? str.tostring(nz(fs.get("mfeStop")) / nL, "0.00") + "R" : "–")
    f_kv(K, V, "Long  n · win · exp", f_side(".L"))
    f_kv(K, V, "Short n · win · exp", f_side(".S"))
    f_kv(K, V, "Avg bars arm→fill", nFill > 0 ? str.tostring(acc.get(1) / nFill, "0.0") : "–")
    for [i, k] in K
        f_cell(dbg, 0, i, k)
        f_cell(dbg, 1, i, V.get(i))

// ── Filter impact (all trades, shadow included) ──
// Trades in [lo, hi) tagged by filter bit fi (removed) vs not (kept): count and expectancy.
f_split(int fi, int lo, int hi) =>
    int   nR = 0
    int   nK = 0
    float sR = 0.0
    float sK = 0.0
    if hi > lo
        for i = lo to hi - 1
            if f_has(trMask.get(i), fi)
                nR += 1
                sR += trR.get(i)
            else
                nK += 1
                sK += trR.get(i)
    [nR, nR > 0 ? sR / nR : na, nK > 0 ? sK / nK : na]

f_verdict(int nRem, float rem, float kept) =>
    na(rem) ? "Need data" : rem < 0 and nRem >= 20 ? "Enforce" : not na(kept) and rem > kept ? "Drop" : "Need data"

// R of the trades in [lo, hi) whose bucket key equals want (want = -1: every trade).
f_sel(array<int> K, int want, int lo, int hi) =>
    array<float> X = array.new<float>()
    if hi > lo
        for i = lo to hi - 1
            if want < 0 or K.get(i) == want
                X.push(trR.get(i))
    X

f_bucketRows(table t, int row0, string title, array<int> K, array<string> names, int N) =>
    int row = f_robHead(t, row0, title)
    for [k, nm] in names
        row := f_robRow(t, row, "  " + nm, f_sel(K, k, 0, N))
    row

if debugMode and debugBreakdown and barstate.islast
    if na(imp)
        imp := table.new(f_pos(posImpact), 6, 60, bgcolor = color.new(color.gray, 90), frame_width = 0, border_width = 0)
    int N    = trR.size()
    int half = int(math.floor(N / 2))
    int row  = 0
    for [ci, h] in array.from("Filter (all trades)", "Tagged", "Removes", "Removed exp", "Kept exp", "Verdict · H1 · H2")
        f_cell(imp, ci, row, h)
    row += 1
    for fi = 0 to NF
        string fname = FNAMES.get(fi)
        [nR, eR, eK]    = f_split(fi, 0, N)
        [nR1, eR1, eK1] = f_split(fi, 0, half)
        [nR2, eR2, eK2] = f_split(fi, half, N)
        string v  = f_verdict(nR, eR, eK)
        string v1 = f_verdict(nR1, eR1, eK1)
        string v2 = f_verdict(nR2, eR2, eK2)
        f_cell(imp, 0, row, fname + " [" + FMODES.get(fi) + "]")
        f_cell(imp, 1, row, str.tostring(nz(cnt.get("tag." + fname))))
        f_cell(imp, 2, row, str.tostring(nR))
        f_cell(imp, 3, row, f_r(eR))
        f_cell(imp, 4, row, f_r(eK))
        f_cell(imp, 5, row, v + " · " + v1 + " · " + v2 + (v1 != v2 ? " (flips: noise)" : ""))
        row += 1
    // Whole sample, the trades no shadow filter tagged (the Enforce view), and the two halves.
    array<float> clean = array.new<float>()
    if N > 0
        for i = 0 to N - 1
            if trMask.get(i) < int(math.pow(2, NF))
                clean.push(trR.get(i))
    row := f_robHead(imp, row, "Sample")
    row := f_robRow(imp, row, "  All trades (shadow incl.)", f_sel(trSess, -1, 0, N))
    row := f_robRow(imp, row, "  No shadow tags", clean)
    row := f_robRow(imp, row, "  First half", f_sel(trSess, -1, 0, half))
    row := f_robRow(imp, row, "  Second half", f_sel(trSess, -1, half, N))
    row := f_bucketRows(imp, row, "Session (fill, ET)", trSess, array.from("NY 09:30–16:00", "London 03:00–09:30", "Asia / other"), N)
    row := f_bucketRows(imp, row, "Tap 5 ext from mid (zones)", trExt, array.from("<1", "1–2", "2–3", ">3"), N)
    row := f_bucketRows(imp, row, "Zone height (ATR)", trZh, array.from("<1", "1–2", "2–3", ">3"), N)
    row := f_bucketRows(imp, row, "Bars arm→fill", trA2F, array.from("≤10", "11–40", ">40"), N)
    row := f_bucketRows(imp, row, "Planned R:R", trRRb, array.from("<1.5", "1.5–2", "2–3", "3–5", ">5"), N)

// ── Exit variants, daily limits and excursions (chart trades) ──
// Share of X at or above th (atLeast) or at or below th.
f_share(array<float> X, float th, bool atLeast) =>
    int k = 0
    for x in X
        if atLeast ? x >= th : x <= th
            k += 1
    X.size() > 0 ? 1.0 * k / X.size() : na

f_curveRow(table t, int row, string name, string p) =>
    float n = nz(fs.get(p + ".n"))
    f_cell(t, 0, row, name)
    f_cell(t, 1, row, str.tostring(n, "0"))
    f_cell(t, 3, row, f_r(n > 0 ? nz(fs.get(p + ".sum")) / n : na))
    f_cell(t, 5, row, f_r(-nz(fs.get(p + ".dd"))))
    row + 1

if debugMode and debugExits and barstate.islast
    if na(exT)
        exT := table.new(f_pos(posExits), 7, 40, bgcolor = color.new(color.gray, 90), frame_width = 0, border_width = 0)
    int row = 0
    for [ci, h] in array.from("Exit variant (chart trades)", "Win", "Avg win", "Exp", "PF", "Max DD", "Net $")
        f_cell(exT, ci, row, h)
    row += 1
    for [v, nm] in array.from("A  tap 5 (chart)", "B  1.5R", "C  2R", "D  3R", "E  tap 5, BE at 1R", "F  tap 5, BE at 1.5R", "G  ½ at 1R, BE, tap 5")
        string p  = "x" + str.tostring(v)
        float  n  = nz(fs.get(p + ".n"))
        float  nW = nz(fs.get(p + ".nW"))
        float  w  = nz(fs.get(p + ".w"))
        float  l  = nz(fs.get(p + ".l"))
        f_cell(exT, 0, row, nm + "  (" + str.tostring(n, "0") + ")")
        f_cell(exT, 1, row, f_pct(n > 0 ? nW / n : na))
        f_cell(exT, 2, row, f_r(nW > 0 ? w / nW : na))
        f_cell(exT, 3, row, f_r(n > 0 ? nz(fs.get(p + ".sum")) / n : na))
        f_cell(exT, 4, row, l > 0 ? f_ratio(w / l) : w > 0 ? "∞" : "–")
        f_cell(exT, 5, row, f_r(-nz(fs.get(p + ".dd"))))
        f_cell(exT, 6, row, str.tostring(nz(fs.get(p + ".usd")), "#,##0.00"))
        row += 1
    f_cell(exT, 0, row, "  still open")
    f_cell(exT, 1, row, str.tostring(exitTrk.size()))
    row += 1
    if dailyMode != "Off"
        for [ci, h] in array.from("Daily loss limit (day from 18:00 ET)", "n", "", "Exp", "", "Max DD", "")
            f_cell(exT, ci, row, h)
        row += 1
        float nAll = nz(fs.get("n"))
        f_cell(exT, 0, row, "  No limit, all trades")
        f_cell(exT, 1, row, str.tostring(nAll, "0"))
        f_cell(exT, 3, row, f_r(nAll > 0 ? (nz(fs.get("winR")) - nz(fs.get("lossR"))) / nAll : na))
        f_cell(exT, 5, row, f_r(-nz(fs.get("dd"))))
        row += 1
        row := f_curveRow(exT, row, "  No limit, non-optional", "dn")
        row := f_curveRow(exT, row, "  Stop after 2 losses", "d2")
        row := f_curveRow(exT, row, "  Stop after 3 losses", "d3")
    f_cell(exT, 0, row, "Excursions (chart trades)")
    f_cell(exT, 1, row, "share")
    row += 1
    for th in array.from(0.5, 1.0, 1.5, 2.0)
        f_cell(exT, 0, row, "  Stops with MFE ≥ " + str.tostring(th, "0.0#") + "R  (" + str.tostring(stopMFE.size()) + ")")
        f_cell(exT, 1, row, f_pct(f_share(stopMFE, th, true)))
        row += 1
    for th in array.from(0.25, 0.5, 0.75)
        f_cell(exT, 0, row, "  Winners with MAE ≤ " + str.tostring(th, "0.0#") + "R  (" + str.tostring(winMAE.size()) + ")")
        f_cell(exT, 1, row, f_pct(f_share(winMAE, th, false)))
        row += 1

// ───────────────────────── Alert conditions (UI dropdown) ─────────────────────────
alertcondition(fl.get(0), "6-Tap armed (short)",  '{"event":"armed","dir":"short","symbol":"{{ticker}}","tf":"{{interval}}","price":{{close}}}')
alertcondition(fl.get(1), "6-Tap armed (long)",   '{"event":"armed","dir":"long","symbol":"{{ticker}}","tf":"{{interval}}","price":{{close}}}')
alertcondition(fl.get(2), "6-Tap filled (short)", '{"event":"filled","dir":"short","symbol":"{{ticker}}","tf":"{{interval}}","price":{{close}}}')
alertcondition(fl.get(3), "6-Tap filled (long)",  '{"event":"filled","dir":"long","symbol":"{{ticker}}","tf":"{{interval}}","price":{{close}}}')
alertcondition(fl.get(4), "6-Tap cancelled",      '{"event":"cancelled","symbol":"{{ticker}}","tf":"{{interval}}","price":{{close}}}')
