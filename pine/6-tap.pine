alertcondition(fl.get(1), "6-Tap armed (long)",   '{"event":"armed","dir":"long","symbol":"{{ticker}}","tf":"{{interval}}","price":{{close}}}')
alertcondition(fl.get(2), "6-Tap filled (short)", '{"event":"filled","dir":"short","symbol":"{{ticker}}","tf":"{{interval}}","price":{{close}}}')
alertcondition(fl.get(3), "6-Tap filled (long)",  '{"event":"filled","dir":"long","symbol":"{{ticker}}","tf":"{{interval}}","price":{{close}}}')
alertcondition(fl.get(4), "6-Tap cancelled",      '{"event":"cancelled","symbol":"{{ticker}}","tf":"{{interval}}","price":{{close}}}')
alertcondition(fl.get(5), "6-Tap target",         '{"event":"target","symbol":"{{ticker}}","tf":"{{interval}}","price":{{close}}}')
alertcondition(fl.get(6), "6-Tap stop",           '{"event":"stop","symbol":"{{ticker}}","tf":"{{interval}}","price":{{close}}}')
alertcondition(fl.get(7), "6-Tap sweep",          '{"event":"sweep","symbol":"{{ticker}}","tf":"{{interval}}","price":{{close}}}')
alertcondition(fl.get(8), "6-Tap confirm",        '{"event":"confirm","symbol":"{{ticker}}","tf":"{{interval}}","price":{{close}}}')
