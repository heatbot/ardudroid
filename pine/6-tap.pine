// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// 6-Tap v2.8 — detects and marks the 6-tap sequence (reverse-engineered from the AMN model).
// Bearish model shown in comments; bullish is the exact mirror.
//   Tap 1  external swing low (liquidity)      Tap 2  external swing high (protected)
//   Zone   tap 1 .. tap 2, mid = 50%           Tap 3  big BOS / sweep of tap 1
//   Tap 4  internal lower high below mid       Tap 5  mini BOS through tap 3, trails until locked, re-trails if passed
//   Tap 6  limit modes: first touch of the entry level after arming
//          confirmation: the sweep peak; entry on a close beyond the last fractal before it

//@version=6
indicator("6-Tap", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 200, max_bars_back = 500)

// ───────────────────────── Inputs ─────────────────────────
// ==== SHARED INPUTS BEGIN ====  (copied into "6-Tap Strategy" by pine/build_strategy.py)
const string G_BIAS = "Bias"
const string G_STR  = "Structure"
const string G_RULE = "Rules"
const string G_TRD  = "Trade"
const string G_DSP  = "Display"
const string G_CONF = "Confirmation entry"
const string G_TRL  = "Stop management"
const string G_FLT  = "Shadow filters"
const string G_DAY  = "Daily loss limit"
const string G_DBG  = "Debug"

string biasMode       = input.string("Auto", "Bias mode", options = ["Auto", "Bullish", "Bearish"], group = G_BIAS)
string biasTF         = input.timeframe("", "Bias timeframe (empty = chart)", group = G_BIAS, tooltip = "Recommended: 1m chart with 5 here. On a 5m chart leave empty.")
int    biasLen        = input.int(15, "Bias pivot length", minval = 2, group = G_BIAS, tooltip = "Swings used for bias only, kept longer than the external pivot length so a zone's own leg does not flip bias")
bool   biasCancel     = input.bool(false, "Cancel sequences when bias flips", group = G_BIAS, tooltip = "Off: bias only filters new sequences; a close beyond tap 2 invalidates")

int    extLen         = input.int(5, "External pivot length", minval = 2, group = G_STR, tooltip = "Taps 1–3 and bias")
int    intLen         = input.int(2, "Internal pivot length", minval = 1, group = G_STR, tooltip = "Taps 4–5 and tap 5 locking")
string breakMode3     = input.string("Wick", "Tap 3 break", options = ["Wick", "Close"], group = G_STR)
string breakMode5     = input.string("Close", "Tap 5 break", options = ["Wick", "Close"], group = G_STR)
float  minZoneATR     = input.float(1.0, "Min zone size (× ATR 14)", minval = 0, step = 0.1, group = G_STR)

bool   require4InZone = input.bool(false, "Tap 4 must be inside the zone", group = G_RULE)
string mitMode        = input.string("Off", "Invalidate if mid is hit before tap 5", options = ["Off", "Close", "Wick"], group = G_RULE)
float  maxTap5Ext     = input.float(3.0, "Max tap 5 extension (× zone height from mid)", minval = 0.1, step = 0.1, group = G_RULE)
int    minArmBars     = input.int(1, "Bars armed before trade lines show", minval = 0, group = G_RULE)
int    maxActive      = input.int(10, "Max active sequences", minval = 1, group = G_RULE)
int    dedupeOverlap  = input.int(50, "Dedupe overlap (%)", minval = 0, maxval = 100, group = G_RULE)
int    maxArmedPerDir = input.int(3, "Max armed orders drawn per direction", minval = 1, group = G_RULE, tooltip = "Extra armed orders still count in stats and alerts; their pending lines are not drawn")

string entryMode      = input.string("Confirmation", "Entry mode", options = ["50% limit", "Tap 4 sweep", "Confirmation"], group = G_TRD, tooltip = "Confirmation: wait for the sweep of tap 4 into the zone, then enter on a close beyond the last fractal before the sweep peak, stop beyond the peak. The other modes rest a limit order at arming.")
string targetMode     = input.string("Tap 5", "Target mode", options = ["Tap 5", "Tap 5 + ext", "Fixed R"], group = G_TRD)
int    targetExtTicks = input.int(0, "Target extension (ticks)", minval = 0, group = G_TRD)
float  fixedR         = input.float(2.0, "Fixed R", minval = 0.1, step = 0.1, group = G_TRD)
float  stopBufferATR  = input.float(0.1, "Stop buffer (× ATR 14)", minval = 0, step = 0.05, group = G_TRD)

string sweepLevel     = input.string("Zone edge", "Sweep must reach", options = ["Zone edge", "50%", "Tap 4 only"], group = G_CONF, tooltip = "Zone edge = tap 1")
