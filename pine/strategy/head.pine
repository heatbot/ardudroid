// 6-Tap Strategy v3.3 — the 6-Tap indicator's engine with real orders, for Deep Backtesting.
// GENERATED by pine/build_strategy.py from pine/6-tap.pine (shared inputs + engine) and
// pine/strategy/head.pine + tail.pine. Edit those files, not this one.

//@version=6
strategy("6-Tap Strategy", overlay = true,
     initial_capital = 10000, currency = currency.USD,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.62,
     slippage = 1,
     pyramiding = 3,
     margin_long = 0, margin_short = 0,
     backtest_fill_limits_assumption = 1,
     use_bar_magnifier = true,
     process_orders_on_close = false,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 200, max_bars_back = 500)

// ───────────────────────── Inputs ─────────────────────────
//@@SHARED_INPUTS@@

const string G_ST = "Strategy (all enforced)"
string exitVariant      = input.string("D  3R", "Exit variant", options = ["A  tap 5", "B  1.5R", "C  2R", "D  3R", "E  tap 5, BE at 1R", "F  tap 5, BE at 1.5R", "G  ½ at 1R, BE, tap 5", "H  4R", "I  5R", "J  3R, trail one behind", "K  3R, trail latest", "L  tap 5, trail one behind"], group = G_ST, tooltip = "Same variants as the indicator's exit table. J/K/L trail with the Stop management inputs. G needs 2+ contracts.")
float  maxZoneATRIn     = input.float(3.0, "Max zone size (× ATR 14, 0 = off)", minval = 0, step = 0.1, group = G_ST)
float  minTap5ExtIn     = input.float(0.0, "Min tap 5 extension at arming (zone heights, 0 = off)", minval = 0, step = 0.1, group = G_ST)
string sessionMode      = input.string("All", "Sessions (fills)", options = ["All", "Skip NY", "London only", "London + Asia"], group = G_ST, tooltip = "Orders are only working during the chosen sessions (NY 09:30–16:00, London 03:00–09:30 ET, Asia = the rest)")
float  minRR            = input.float(0.0, "Min planned R:R (0 = off)", minval = 0, step = 0.1, group = G_ST)
int    maxBarsArmToFill = input.int(0, "Cancel order after bars armed (0 = off)", minval = 0, group = G_ST)
int    dailyMaxLosses   = input.int(0, "Max losing trades per day (0 = off)", minval = 0, group = G_ST, tooltip = "Day starts 18:00 ET")
int    maxConcurrent    = input.int(1, "Max open + pending positions", minval = 1, maxval = 3, group = G_ST)
bool   allowOpposite    = input.bool(false, "Allow opposite-direction orders while a position is open", group = G_ST, tooltip = "Pine nets positions: an opposite fill closes or reverses the open one")
int    contracts        = input.int(1, "Contracts", minval = 1, group = G_ST)
int    startDate        = input.time(timestamp("01 Jan 2000 00:00 +0000"), "Entries from", group = G_ST)
int    endDate          = input.time(timestamp("31 Dec 2099 23:59 +0000"), "Entries until", group = G_ST)
bool   requireFVG       = input.bool(false, "Require the FVG to be touched before the fill", group = G_ST, tooltip = "Off until the indicator's impact table shows FVG-touched trades beat the rest")
bool   showDrawings     = input.bool(true, "Show drawings (off = faster deep backtests)", group = G_ST)
bool   debugOrders      = input.bool(false, "Log armed setups that place no order (Pine Logs)", group = G_ST)
string rTablePos        = input.string("top_right", "R table position", options = ["top_left", "top_right", "bottom_left", "bottom_right"], group = G_ST)
string tableTextSize    = input.string("tiny", "Table text size", options = ["tiny", "small", "normal"], group = G_ST)

// Engine settings derived from the strategy inputs (no shadow mode here).
float  maxRR             = 0.0
string runMode           = "Off"
string expMode           = maxBarsArmToFill > 0 ? "Enforce" : "Off"
int    expiryBars        = math.max(1, maxBarsArmToFill)
string supMode           = "Off"
string zoneMode          = minZoneATR > 0 ? "Enforce" : "Off"
string maxZoneMode       = maxZoneATRIn > 0 ? "Enforce" : "Off"
float  maxZoneATR        = maxZoneATRIn > 0 ? maxZoneATRIn : 1e9
string extMinMode        = minTap5ExtIn > 0 ? "Enforce" : "Off"
float  minTap5Ext        = minTap5ExtIn
string sessMode          = "Off"
string fvgMode           = requireFVG ? "Enforce" : "Off"
string dailyMode         = "Off"
bool   debugMode         = false
bool   debugLog          = false
float  commissionPerSide = 0.62
bool   DRAW              = showDrawings
array<string> FMODES     = array.from(runMode, expMode, supMode, zoneMode, maxZoneMode, extMinMode, sessMode, fvgMode, "flag")
string tblSize           = tableTextSize == "small" ? size.small : tableTextSize == "normal" ? size.normal : size.tiny

